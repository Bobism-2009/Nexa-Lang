{
  "name": "nexa",
  "displayName": "Nexa Language",
  "description": "Syntax highlighting, snippets, go-to definition, find references, outline, and completions for Nexa (.nxa)",
  "version": "0.1.5",
  "publisher": "nexac",
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:nexa"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "contributes": {
    "languages": [
      {
        "id": "nexa",
        "aliases": ["Nexa", "nexa"],
        "extensions": [".nxa"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nexa",
        "scopeName": "source.nexa",
        "path": "./syntaxes/nexa.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "nexa",
        "path": "./snippets/nexa.json"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.3.0"
  }
}
