{
  "name": "nexa",
  "displayName": "Nexa Language",
  "description": "Syntax highlighting, NexaC errors as you save, completions, parameter hints, hover, rename, go-to definition, outline, folding, and NexaC run/build for Nexa (.nxa)",
  "version": "0.3.2",
  "publisher": "nexac",
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:nexa"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "contributes": {
    "languages": [
      {
        "id": "nexa",
        "aliases": ["Nexa", "nexa"],
        "extensions": [".nxa"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nexa",
        "scopeName": "source.nexa",
        "path": "./syntaxes/nexa.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      { "id": "module", "superType": "namespace", "description": "Standard module (os, file, io)" },
      { "id": "member", "superType": "method", "description": "Module member (system, write)" },
      { "id": "importKeyword", "superType": "keyword", "description": "#include keyword" },
      { "id": "importModule", "superType": "namespace", "description": "Import path module name" },
      { "id": "importPrefix", "superType": "keyword", "description": "std/ in import paths" },
      { "id": "nexaVariable", "superType": "variable", "description": "A variable or parameter this file declares" },
      { "id": "nexaFunctionDef", "superType": "function", "description": "A function's name where fn defines it" },
      { "id": "nexaFunctionCall", "superType": "function", "description": "A function or method being called" },
      { "id": "nexaMacro", "superType": "macro", "description": "A #define name, where it is defined and where it is used" }
    ],
    "snippets": [
      {
        "language": "nexa",
        "path": "./snippets/nexa.json"
      }
    ],
    "configuration": {
      "title": "Nexa",
      "properties": {
        "nexa.nexacPath": {
          "type": "string",
          "default": "NexaC",
          "description": "Path to the NexaC compiler executable (must be on PATH or an absolute path)."
        },
        "nexa.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Check a Nexa file with NexaC when it is opened and each time it is saved, and show its errors and warnings in the editor and the Problems panel. Only the Nexa checks run (NexaC --source), not the C++ compiler."
        }
      }
    },
    "commands": [
      {
        "command": "nexa.runFile",
        "title": "Nexa: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "nexa.buildFile",
        "title": "Nexa: Build Current File",
        "icon": "$(tools)"
      },
      {
        "command": "nexa.showCpp",
        "title": "Nexa: Show Generated C++",
        "icon": "$(file-code)"
      },
      {
        "command": "nexa.checkFile",
        "title": "Nexa: Check Current File"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "nexa.runFile",
          "when": "resourceLangId == nexa",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "nexa.runFile",
          "when": "resourceLangId == nexa"
        },
        {
          "command": "nexa.buildFile",
          "when": "resourceLangId == nexa"
        },
        {
          "command": "nexa.showCpp",
          "when": "resourceLangId == nexa"
        },
        {
          "command": "nexa.checkFile",
          "when": "resourceLangId == nexa"
        }
      ],
      "editor/context": [
        {
          "command": "nexa.showCpp",
          "when": "resourceLangId == nexa",
          "group": "navigation@90"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nexa.runFile",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "resourceLangId == nexa && editorTextFocus"
      }
    ],
    "configurationDefaults": {
      "[nexa]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.semanticTokenColorCustomizations": {
          "enabled": true,
          "rules": {
            "module": "#4EC9B0",
            "member": "#DCDCAA",
            "importKeyword": "#C586C0",
            "importModule": "#4EC9B0",
            "importPrefix": "#569CD6",
            "nexaVariable": "#9CDCFE",
            "nexaFunctionDef": "#C586C0",
            "nexaFunctionCall": "#DCDCAA",
            "nexaMacro": "#569CD6"
          }
        }
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "nexaVariable": "#9CDCFE",
          "nexaFunctionDef": "#C586C0",
          "nexaFunctionCall": "#DCDCAA",
          "nexaMacro": "#569CD6"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.3.0"
  }
}
