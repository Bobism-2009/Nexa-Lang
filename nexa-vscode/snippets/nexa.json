{
  "Nexa: fn main": {
    "prefix": "main",
    "body": ["fn main() {", "\t$0", "}"],
    "description": "Program entry with fn main()"
  },
  "Nexa: fn main args": {
    "prefix": "mainargs",
    "body": ["fn main(args: []string): void {", "\t$0", "}"],
    "description": "fn main with command-line args"
  },
  "Nexa: fn": {
    "prefix": "fn",
    "body": ["fn ${1:name}($2) {", "\t$0", "}"],
    "description": "Function definition"
  },
  "Nexa: extern fn": {
    "prefix": "extern",
    "body": ["extern fn ${1:name}(${2:args}): ${3:int};"],
    "description": "C FFI extern declaration"
  },
  "Nexa: struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:int};",
      "}"
    ],
    "description": "Struct definition"
  },
  "Nexa: enum": {
    "prefix": "enum",
    "body": ["enum ${1:Name} {", "\t${2:VariantA};", "\t${3:VariantB};", "}"],
    "description": "Enum definition"
  },
  "Nexa: include std/io": {
    "prefix": "incio",
    "body": ["#include <std/io>"],
    "description": "Standard I/O module"
  },
  "Nexa: include std/os": {
    "prefix": "incos",
    "body": ["#include <std/os>"],
    "description": "OS module"
  },
  "Nexa: include std/file": {
    "prefix": "incfile",
    "body": ["#include <std/file>"],
    "description": "File I/O module"
  },
  "Nexa: include std/dll": {
    "prefix": "incdll",
    "body": ["#include <std/dll>"],
    "description": "Dynamic library module"
  },
  "Nexa: include std/random": {
    "prefix": "incrnd",
    "body": ["#include <std/random>"],
    "description": "Random module"
  },
  "Nexa: include std/math": {
    "prefix": "incmath",
    "body": ["#include <std/math>"],
    "description": "Math module"
  },
  "Nexa: include std/crypto": {
    "prefix": "inccrypto",
    "body": ["#include <std/crypto>"],
    "description": "Crypto module"
  },
  "Nexa: include std/network": {
    "prefix": "incnetwork",
    "body": ["#include <std/network>"],
    "description": "Network module: http.*, tcp.* and udp.*"
  },
  "Nexa: include std/json": {
    "prefix": "incjson",
    "body": ["#include <std/json>"],
    "description": "JSON module"
  },
  "Nexa: include std/thread": {
    "prefix": "incthread",
    "body": ["#include <std/thread>"],
    "description": "Threading module"
  },
  "Nexa: include std/inline": {
    "prefix": "incinline",
    "body": ["#include <std/inline>"],
    "description": "inline_cpp! escape hatch"
  },
  "Nexa: println": {
    "prefix": "println",
    "body": ["io.println(${1:\"\"});"],
    "description": "io.println"
  },
  "Nexa: let": {
    "prefix": "let",
    "body": ["let ${1:x} = $0;"],
    "description": "let binding"
  },
  "Nexa: let typed": {
    "prefix": "lett",
    "body": ["let ${1:x}: ${2:int} = $0;"],
    "description": "Typed let binding"
  },
  "Nexa: for-in": {
    "prefix": "forin",
    "body": ["for (${1:x} in ${2:arr}) {", "\t$0", "}"],
    "description": "for-in loop over array"
  },
  "Nexa: while": {
    "prefix": "while",
    "body": ["while (${1:condition}) {", "\t$0", "}"],
    "description": "while loop"
  },
  "Nexa: if": {
    "prefix": "if",
    "body": ["if (${1:condition}) {", "\t$0", "}"],
    "description": "if statement"
  },
  "Nexa: switch": {
    "prefix": "switch",
    "body": ["switch (${1:expr}) {", "\tcase ${2:0}:", "\t\t$0", "\tbreak;", "}"],
    "description": "switch statement"
  },
  "Nexa: __init__": {
    "prefix": "init",
    "body": ["fn __init__() {", "\t$0", "}"],
    "description": "Library init hook"
  },
  "Nexa: inline_cpp": {
    "prefix": "inlinecpp",
    "body": ["inline_cpp! {", "\t$0", "}"],
    "description": "Raw C++ block (requires std/inline)"
  },
  "Nexa: new": {
    "prefix": "new",
    "body": ["let ${1:p}: *${2:int} = new ${2:int};"],
    "description": "Heap allocate one object"
  },
  "Nexa: new array": {
    "prefix": "newa",
    "body": ["let ${1:p}: *${2:int} = new ${2:int}[${3:n}];"],
    "description": "Heap allocate array"
  },
  "Nexa: delete": {
    "prefix": "delete",
    "body": ["delete ${1:p};"],
    "description": "Free a single new T allocation"
  },
  "Nexa: delete[]": {
    "prefix": "deletea",
    "body": ["delete[] ${1:p};"],
    "description": "Free a new T[n] allocation"
  },
  "Nexa: sizeof": {
    "prefix": "sizeof",
    "body": ["sizeof(${1:int})"],
    "description": "Byte size of a type or expression"
  },
  "Nexa: struct array": {
    "prefix": "sarr",
    "body": ["let ${1:pts}: ${2:Point}[${3:10}];"],
    "description": "Fixed-size stack array of structs"
  },
  "Nexa: defer": {
    "prefix": "defer",
    "body": ["defer ${1:cleanup};"],
    "description": "Run a statement when the enclosing block exits"
  },
  "Nexa: defer block": {
    "prefix": "deferb",
    "body": ["defer {", "\t$0", "}"],
    "description": "Run a block when the enclosing block exits"
  },
  "Nexa: if in": {
    "prefix": "in",
    "body": ["if (${1:x} in [${2:a, b}]) {", "\t$0", "}"],
    "description": "True when x equals any of the listed values"
  },
  "Nexa: try": {
    "prefix": "try",
    "body": ["try {", "\t$0", "} catch (${1:e}) {", "\t", "}"],
    "description": "try/catch; e is the thrown string"
  },
  "Nexa: float32": {
    "prefix": "f32",
    "body": ["let ${1:v}: float32 = ${2:0.0};"],
    "description": "32-bit float"
  },
  "Nexa: include std/time": {
    "prefix": "inctime",
    "body": ["#include <std/time>"],
    "description": "Time module"
  },
  "Nexa: include std/term": {
    "prefix": "incterm",
    "body": ["#include <std/term>"],
    "description": "Terminal colour, cursor and keys"
  },
  "Nexa: include std/gfx": {
    "prefix": "incgfx",
    "body": ["#include <std/gfx>"],
    "description": "Pixel window module"
  },
  "Nexa: include std/gfx3d": {
    "prefix": "incgfx3d",
    "body": ["#include <std/gfx3d>"],
    "description": "3D window module"
  },
  "Nexa: include std/ui": {
    "prefix": "incui",
    "body": ["#include <std/ui>"],
    "description": "Widgets on the gfx window"
  },
  "Nexa: type alias": {
    "prefix": "type",
    "body": ["type ${1:Name} = ${2:int};"],
    "description": "Short name for a type"
  },
  "Nexa: type alias with params": {
    "prefix": "typegen",
    "body": ["type ${1:Dict}[${2:T}] = ${3:map[string]T};"],
    "description": "Type alias that takes types, like Dict[T]"
  },
  "Nexa: shape": {
    "prefix": "shape",
    "body": [
      "shape ${1:Drawable} {",
      "\tfn ${2:draw}();",
      "\tfn ${3:width}(): ${4:int};",
      "}"
    ],
    "description": "Name the functions a type must have"
  },
  "Nexa: priv fn": {
    "prefix": "privfn",
    "body": ["priv fn ${1:helper}($2) {", "\t$0", "}"],
    "description": "Function kept inside this file"
  },
  "Nexa: priv struct": {
    "prefix": "privstruct",
    "body": [
      "priv struct ${1:Name} {",
      "\t${2:field}: ${3:int};",
      "}"
    ],
    "description": "Struct kept inside this file"
  },
  "Nexa: destructure let": {
    "prefix": "letdest",
    "body": ["let ${1:Point} { ${2:x}, ${3:y} } = ${4:p};"],
    "description": "Bind a struct's fields as locals"
  },
  "Nexa: generic fn": {
    "prefix": "fngen",
    "body": ["fn ${1:id}[${2:T}](${3:x}: ${2:T}): ${2:T} {", "\treturn ${3:x};", "}"],
    "description": "Function that names a type"
  },
  "Nexa: shape-bound fn": {
    "prefix": "fnshape",
    "body": [
      "fn ${1:paint}[${2:T}: ${3:Drawable}](${4:x}: ${2:T}) {",
      "\t${4:x}.${5:draw}();",
      "}"
    ],
    "description": "Generic function that requires a shape"
  },
  "Nexa: float64": {
    "prefix": "f64",
    "body": ["let ${1:v}: float64 = ${2:0.0};"],
    "description": "64-bit float (same as float)"
  },
  "Nexa: match": {
    "prefix": "match",
    "body": ["match (${1:value}) {", "\t${2:Pattern} => ${3:result},", "\t_ => ${0:other},", "}"],
    "description": "match on enum variants, Result, ints, strings or ranges"
  },
  "Nexa: match Option": {
    "prefix": "matchopt",
    "body": ["match (${1:opt}) {", "\tSome { ${2:v} } => ${3:v},", "\tNone => ${0:fallback},", "}"],
    "description": "match on an Option: Some { value } or None"
  },
  "Nexa: for range": {
    "prefix": "forrange",
    "body": ["for (${1:i} in ${2:0}..<${3:n}) {", "\t$0", "}"],
    "description": "Range loop: 0..<n stops before n, 1..10 includes 10"
  },
  "Nexa: range loop counting down": {
    "prefix": "fordown",
    "body": ["for (${1:i} in ${2:10}..${3:1} step -${4:1}) {", "\t$0", "}"],
    "description": "Range loop with a step: 10..1 step -1 counts down"
  },
  "Nexa: slice sort_by": {
    "prefix": "sortby",
    "body": ["${1:xs}.sort_by(fn (a, b) { return a.${2:field} < b.${2:field}; });"],
    "description": "Sort in place, stably, in the order the function gives"
  },
  "Nexa: return Some": {
    "prefix": "some",
    "body": ["return Some(${1:value});"],
    "description": "Return Option[T]'s value"
  },
  "Nexa: #define": {
    "prefix": "define",
    "body": ["#define ${1:NAME} ${0:value}"],
    "description": "C macro: a name replaced by its tokens"
  },
  "Nexa: #define function-like": {
    "prefix": "definefn",
    "body": ["#define ${1:SQ}(${2:x}) ${0:((x) * (x))}"],
    "description": "C function-like macro (no space before '(')"
  },
  "Nexa: #undef": {
    "prefix": "undef",
    "body": ["#undef ${1:NAME}"],
    "description": "End a macro"
  },
  "Nexa: inline_asm": {
    "prefix": "inlineasm",
    "body": ["inline_asm!(in ${1:a}, out ${2:r}) {", "\tmov {${2:r}\\}, {${1:a}\\}$0", "}"],
    "description": "CPU instructions with Nexa variables as operands (#include <std/inline>)"
  },
  "Nexa: slice filter": {
    "prefix": "filter",
    "body": ["${1:xs}.filter(fn (${2:x}) { return ${0:true}; })"],
    "description": "Keep the elements a function says yes to"
  }
}
