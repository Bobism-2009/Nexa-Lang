{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nexa",
  "scopeName": "source.nexa",
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#raw-strings" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#inline-cpp" },
    { "include": "#struct-def" },
    { "include": "#enum-def" },
    { "include": "#function-def" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#builtin-modules" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nexa",
          "match": "//[^\\n\\r]*"
        },
        {
          "name": "comment.block.nexa",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.include.nexa",
          "match": "^\\s*(#include)\\s+(<[^>\\r\\n]+>|\"[^\"\\r\\n]*\")",
          "captures": {
            "1": { "name": "keyword.control.import.nexa" },
            "2": { "name": "string.quoted.include.nexa" }
          }
        }
      ]
    },
    "raw-strings": {
      "patterns": [
        {
          "name": "string.quoted.double.raw.nexa",
          "begin": "R\"([^()\\\\\\\"\n]*)\\(",
          "end": "\\)\\1\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.nexa" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.nexa" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nexa",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nexa",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.nexa",
          "match": "'(?:\\\\.|[^'\\\\])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nexa",
          "match": "-?\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.float.nexa",
          "match": "-?\\b\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.nexa",
          "match": "-?\\b\\d+\\b"
        }
      ]
    },
    "inline-cpp": {
      "patterns": [
        {
          "name": "keyword.other.inline_cpp.nexa",
          "match": "\\binline_cpp\\s*!"
        }
      ]
    },
    "struct-def": {
      "patterns": [
        {
          "name": "meta.struct.nexa",
          "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.nexa" },
            "2": { "name": "entity.name.type.struct.nexa" }
          }
        }
      ]
    },
    "enum-def": {
      "patterns": [
        {
          "name": "meta.enum.nexa",
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.nexa" },
            "2": { "name": "entity.name.type.enum.nexa" }
          }
        }
      ]
    },
    "function-def": {
      "patterns": [
        {
          "name": "meta.function.nexa",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "captures": {
            "1": { "name": "keyword.control.nexa" },
            "2": { "name": "entity.name.function.nexa" },
            "3": { "name": "punctuation.definition.parameters.begin.nexa" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.type.nexa",
          "match": "\\b(int|string|bool|float|char|unsigned\\s+char)\\b"
        },
        {
          "name": "keyword.control.nexa",
          "match": "\\b(fn|let|const|struct|enum|if|else|while|for|switch|case|default|return|break|continue)\\b"
        },
        {
          "name": "keyword.other.entry.nexa",
          "match": "\\b(main|__init__)\\b"
        },
        {
          "name": "constant.language.boolean.nexa",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.nexa",
          "match": "\\blen(?=\\s*\\()"
        }
      ]
    },
    "builtin-modules": {
      "patterns": [
        {
          "name": "support.function.module.nexa",
          "match": "\\b(io|os|dll|file|random|time)\\.([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.namespace.nexa" },
            "2": { "name": "entity.name.function.member.nexa" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.shift.assign.nexa",
          "match": "<<=|>>="
        },
        {
          "name": "keyword.operator.bitwise.shift.nexa",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.nexa",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.nexa",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.assignment.bitwise.nexa",
          "match": "&=|\\|=|\\^="
        },
        {
          "name": "keyword.operator.assignment.nexa",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.increment.nexa",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.bitwise.nexa",
          "match": "~"
        },
        {
          "name": "keyword.operator.comparison.nexa",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.bitwise.nexa",
          "match": "(?<![&])&(?![&=])"
        },
        {
          "name": "keyword.operator.bitwise.nexa",
          "match": "(?<!\\|)\\|(?![\\|=])"
        },
        {
          "name": "keyword.operator.bitwise.nexa",
          "match": "(?<!\\^)\\^(?!=)"
        },
        {
          "name": "keyword.operator.logical.nexa",
          "match": "(?<!=)!(?!=)"
        },
        {
          "name": "keyword.operator.assignment.nexa",
          "match": "(?<![=!<>])=(?!=)"
        },
        {
          "name": "keyword.operator.arithmetic.nexa",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.nexa",
          "match": "[,;:\\.]"
        },
        {
          "name": "punctuation.section.nexa",
          "match": "[\\(\\)\\{\\}\\[\\]]"
        }
      ]
    }
  }
}
