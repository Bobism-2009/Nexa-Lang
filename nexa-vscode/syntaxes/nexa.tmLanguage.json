{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nexa",
  "scopeName": "source.nexa",
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#function-def" },
    { "include": "#keywords" },
    { "include": "#builtin-modules" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nexa",
          "match": "//[^\\n\\r]*"
        },
        {
          "name": "comment.block.nexa",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.include.nexa",
          "match": "^\\s*(#include)\\s+(<[^>\\r\\n]+>|\"[^\"\\r\\n]*\")",
          "captures": {
            "1": { "name": "keyword.control.import.nexa" },
            "2": { "name": "string.quoted.include.nexa" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nexa",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nexa",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.nexa",
          "match": "'(?:\\\\.|[^'\\\\])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nexa",
          "match": "-?\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.nexa",
          "match": "-?\\b\\d+\\b"
        }
      ]
    },
    "function-def": {
      "patterns": [
        {
          "name": "meta.function.nexa",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "captures": {
            "1": { "name": "keyword.control.nexa" },
            "2": { "name": "entity.name.function.nexa" },
            "3": { "name": "punctuation.definition.parameters.begin.nexa" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.type.nexa",
          "match": "\\b(int|string|bool|float|char|unsigned\\s+char)\\b"
        },
        {
          "name": "keyword.control.nexa",
          "match": "\\b(fn|let|const|if|else|while|for|switch|case|default|return|break|continue)\\b"
        },
        {
          "name": "keyword.other.entry.nexa",
          "match": "\\b(main|__init__)\\b"
        },
        {
          "name": "constant.language.boolean.nexa",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "builtin-modules": {
      "patterns": [
        {
          "name": "support.function.module.nexa",
          "match": "\\b(io|os|dll|file|random)\\.([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.namespace.nexa" },
            "2": { "name": "entity.name.function.member.nexa" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.nexa",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.comparison.nexa",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.logical.nexa",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.nexa",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.assignment.nexa",
          "match": "(?<![=!<>])=(?!=)"
        },
        {
          "name": "keyword.operator.increment.nexa",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.arithmetic.nexa",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.nexa",
          "match": "[,;:\\.]"
        },
        {
          "name": "punctuation.section.nexa",
          "match": "[\\(\\)\\{\\}\\[\\]]"
        }
      ]
    }
  }
}
