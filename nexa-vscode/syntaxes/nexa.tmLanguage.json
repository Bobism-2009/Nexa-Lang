{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nexa",
  "scopeName": "source.nexa",
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#builtin-modules" },
    { "include": "#raw-strings" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#inline-cpp" },
    { "include": "#option" },
    { "include": "#struct-def" },
    { "include": "#enum-def" },
    { "include": "#type-def" },
    { "include": "#shape-def" },
    { "include": "#function-def" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nexa",
          "match": "//[^\\n\\r]*"
        },
        {
          "name": "comment.block.nexa",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.macro.nexa",
          "match": "^\\s*(#\\s*define)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:(\\()([^)]*)(\\)))?",
          "captures": {
            "1": { "name": "keyword.control.directive.define.nexa" },
            "2": { "name": "entity.name.function.preprocessor.nexa" },
            "3": { "name": "punctuation.definition.parameters.begin.nexa" },
            "4": { "name": "variable.parameter.preprocessor.nexa" },
            "5": { "name": "punctuation.definition.parameters.end.nexa" }
          }
        },
        {
          "name": "meta.preprocessor.undef.nexa",
          "match": "^\\s*(#\\s*undef)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.directive.undef.nexa" },
            "2": { "name": "entity.name.function.preprocessor.nexa" }
          }
        },
        {
          "name": "meta.preprocessor.conditional.nexa",
          "begin": "^\\s*(#\\s*(?:if|elif))\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.directive.conditional.nexa" }
          },
          "end": "(?=$)",
          "patterns": [
            { "name": "keyword.control.directive.defined.nexa", "match": "\\b(?:defined|__has_include)\\b" },
            { "include": "$self" }
          ]
        },
        {
          "name": "meta.preprocessor.conditional.nexa",
          "match": "^\\s*(#\\s*(?:ifdef|ifndef|elifdef|elifndef))\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.directive.conditional.nexa" },
            "2": { "name": "entity.name.function.preprocessor.nexa" }
          }
        },
        {
          "name": "keyword.control.directive.conditional.nexa",
          "match": "^\\s*#\\s*(?:else|endif)\\b"
        },
        {
          "name": "meta.preprocessor.diagnostic.nexa",
          "match": "^\\s*(#\\s*(?:error|warning))\\b(.*)$",
          "captures": {
            "1": { "name": "keyword.control.directive.diagnostic.nexa" },
            "2": { "name": "string.unquoted.diagnostic.nexa" }
          }
        },
        {
          "name": "meta.preprocessor.line.nexa",
          "begin": "^\\s*(#\\s*(?:line|pragma))\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.directive.nexa" }
          },
          "end": "(?=$)",
          "patterns": [
            { "name": "keyword.control.directive.pragma.nexa", "match": "\\b(?:once|message)\\b" },
            { "include": "$self" }
          ]
        },
        {
          "name": "keyword.operator.token-paste.nexa",
          "match": "##"
        },
        {
          "name": "keyword.operator.stringize.nexa",
          "match": "(?<=[\\w)\\s(,])#(?=\\s*[A-Za-z_])"
        },
        {
          "name": "variable.language.va-args.nexa",
          "match": "\\b__VA_(?:ARGS|OPT)__\\b"
        },
        {
          "name": "support.constant.predefined-macro.nexa",
          "match": "\\b(?:__LINE__|__FILE__|__COUNTER__|__NEXA__|_WIN32|_WIN64|__linux__|__unix__|__APPLE__|__MACH__|__wasm__|__wasm32__|__wasi__|__x86_64__|__aarch64__|__i386__|__arm__|__mips__|__riscv)\\b"
        },
        {
          "name": "meta.preprocessor.include.angle.nexa",
          "begin": "^\\s*(#include)\\s*(<)",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.nexa" },
            "2": { "name": "punctuation.definition.string.begin.nexa" }
          },
          "end": "(>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.nexa" }
          },
          "patterns": [
            {
              "name": "meta.import.std.nexa",
              "match": "(std/)(io|os|dll|file|random|math|crypto|network|json|time|thread|term|gfx3d|gfx|ui|inline)\\b",
              "captures": {
                "1": { "name": "keyword.other.import.prefix.nexa" },
                "2": { "name": "entity.name.namespace" }
              }
            },
            {
              "name": "meta.import.package.nexa",
              "match": "([A-Za-z_][A-Za-z0-9_-]*)(/)([A-Za-z_][A-Za-z0-9_-]*)",
              "captures": {
                "1": { "name": "entity.name.namespace" },
                "2": { "name": "punctuation.separator.path.nexa" },
                "3": { "name": "entity.name.namespace" }
              }
            },
            {
              "name": "entity.name.namespace",
              "match": "[A-Za-z_][A-Za-z0-9_-]*"
            }
          ]
        },
        {
          "name": "meta.preprocessor.include.quote.nexa",
          "begin": "^\\s*(#include)\\s*(\")",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.nexa" },
            "2": { "name": "punctuation.definition.string.begin.nexa" }
          },
          "end": "(\")",
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.nexa" }
          },
          "patterns": [
            {
              "name": "string.quoted.double.nexa",
              "match": "[^\"\\r\\n]+"
            }
          ]
        }
      ]
    },
    "raw-strings": {
      "patterns": [
        {
          "name": "string.quoted.double.raw.nexa",
          "begin": "R\"([^()\\\\\\\"\n]*)\\(",
          "end": "\\)\\1\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.nexa" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.nexa" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.nexa",
          "begin": "\\bf\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.nexa" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.nexa" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.nexa",
              "match": "\\\\.|\\{\\{|\\}\\}"
            },
            {
              "name": "meta.interpolation.nexa",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.nexa" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.nexa" }
              },
              "contentName": "source.nexa",
              "patterns": [{ "include": "$self" }]
            }
          ]
        },
        {
          "name": "string.quoted.double.nexa",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nexa",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.nexa",
          "match": "'(?:\\\\.|[^'\\\\])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nexa",
          "match": "-?\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.float.nexa",
          "match": "(?<![\\.\\w])-?\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.nexa",
          "match": "-?\\b\\d+\\b"
        }
      ]
    },
    "inline-cpp": {
      "patterns": [
        {
          "name": "keyword.other.inline_cpp.nexa",
          "match": "\\binline_cpp\\s*!"
        },
        {
          "name": "keyword.other.inline_asm.nexa",
          "match": "\\binline_asm\\s*!"
        }
      ]
    },
    "option": {
      "patterns": [
        {
          "name": "support.function.builtin.option.nexa",
          "match": "\\bSome(?=\\s*\\()"
        },
        {
          "name": "constant.language.none.nexa",
          "match": "(?<!\\.)\\bNone\\b"
        }
      ]
    },
    "struct-def": {
      "patterns": [
        {
          "name": "meta.struct.nexa",
          "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.nexa" },
            "2": { "name": "entity.name.type.struct.nexa" }
          }
        }
      ]
    },
    "enum-def": {
      "patterns": [
        {
          "name": "meta.enum.nexa",
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.nexa" },
            "2": { "name": "entity.name.type.enum.nexa" }
          }
        }
      ]
    },
    "type-def": {
      "patterns": [
        {
          "name": "meta.type.alias.nexa",
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.nexa" },
            "2": { "name": "entity.name.type.nexa" }
          }
        }
      ]
    },
    "shape-def": {
      "patterns": [
        {
          "name": "meta.shape.nexa",
          "match": "\\b(shape)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.nexa" },
            "2": { "name": "entity.name.type.shape.nexa" }
          }
        }
      ]
    },
    "function-def": {
      "patterns": [
        {
          "name": "meta.function.extern.nexa",
          "match": "\\b(extern)\\s+(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "captures": {
            "1": { "name": "keyword.control.nexa" },
            "2": { "name": "keyword.control.nexa" },
            "3": { "name": "entity.name.function.nexa" },
            "4": { "name": "punctuation.definition.parameters.begin.nexa" }
          }
        },
        {
          "name": "meta.function.generic.nexa",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\[)",
          "captures": {
            "1": { "name": "keyword.control.nexa" },
            "2": { "name": "entity.name.function.nexa" },
            "3": { "name": "punctuation.definition.typeparameters.begin.nexa" }
          }
        },
        {
          "name": "meta.function.nexa",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "captures": {
            "1": { "name": "keyword.control.nexa" },
            "2": { "name": "entity.name.function.nexa" },
            "3": { "name": "punctuation.definition.parameters.begin.nexa" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.nexa",
          "match": "(?:\\[\\]\\s*)+(?:\\*\\s*)*(?:unsigned\\s+int|unsigned\\s+short|unsigned\\s+long|unsigned\\s+char|float64|float32|size_t|int|short|long|string|bool|float|char|void|[A-Z][A-Za-z0-9_]*)\\b"
        },
        {
          "name": "storage.type.nexa",
          "match": "\\b(?:Result|result|map)\\s*\\[\\s*(?:\\[\\]\\s*)*(?:\\*\\s*)*(?:unsigned\\s+int|unsigned\\s+short|unsigned\\s+long|unsigned\\s+char|float64|float32|size_t|int|short|long|string|bool|float|char|void|[A-Z][A-Za-z0-9_]*)\\s*\\]"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.type.nexa",
          "match": "\\b(unsigned\\s+int|unsigned\\s+short|unsigned\\s+long|unsigned\\s+char|int|short|long|size_t|string|bool|float64|float32|float|char|void)\\b"
        },
        {
          "name": "storage.type.pointer.nexa",
          "match": "\\*+(?:float64|float32|int|string|char|void|float|bool|[A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "name": "keyword.control.nexa",
          "match": "\\b(fn|extern|new|delete|sizeof|let|const|struct|enum|type|shape|priv|if|else|while|for|switch|match|case|default|return|break|continue|defer|goto|try|catch|throw|in)\\b"
        },
        {
          "name": "keyword.control.step.nexa",
          "match": "\\bstep\\b(?=\\s+(?!in\\b)-?\\s*[A-Za-z0-9_(])"
        },
        {
          "name": "keyword.operator.logical.word.nexa",
          "match": "(?<!\\.)\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.other.entry.nexa",
          "match": "\\b(main|__init__)\\b"
        },
        {
          "name": "variable.language.self.nexa",
          "match": "\\bself\\b"
        },
        {
          "name": "constant.language.null.nexa",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.language.boolean.nexa",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.nexa",
          "match": "\\b(len|trim|bits|from_bits32|from_bits64)(?=\\s*\\()"
        },
        {
          "name": "support.function.builtin.nexa",
          "match": "(?<=\\.)(upper|lower|trim|len|contains|starts_with|ends_with|index_of|last_index_of|count|replace|substring|repeat|split|join|push|pop|insert|remove|clear|has|keys|values|sort|sort_desc|reverse|min|max|sum|find|any|all|filter|map|first|last|get|is_some|is_none|or|ok|value|error)(?=\\s*\\()"
        }
      ]
    },
    "builtin-modules": {
      "patterns": [
        {
          "name": "meta.module.access.nexa",
          "match": "\\b(io|os|dll|file|random|math|crypto|http|tcp|udp|json|time|thread|term|gfx3d|gfx|ui)\\.([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.namespace" },
            "2": { "name": "entity.name.function" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.shift.assign.nexa",
          "match": "<<=|>>="
        },
        {
          "name": "keyword.operator.bitwise.shift.nexa",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.nexa",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.nexa",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.assignment.bitwise.nexa",
          "match": "&=|\\|=|\\^="
        },
        {
          "name": "keyword.operator.assignment.nexa",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.increment.nexa",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.bitwise.nexa",
          "match": "~"
        },
        {
          "name": "keyword.operator.comparison.nexa",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.arrow.nexa",
          "match": "->"
        },
        {
          "name": "keyword.operator.fat-arrow.nexa",
          "match": "=>"
        },
        {
          "name": "keyword.operator.address.nexa",
          "match": "(?<![&])&(?![&=])"
        },
        {
          "name": "keyword.operator.dereference.nexa",
          "match": "(?<![*])\\*(?![*=])"
        },
        {
          "name": "keyword.operator.ellipsis.nexa",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.nexa",
          "match": "\\.\\.<?"
        },
        {
          "name": "keyword.operator.bitwise.nexa",
          "match": "(?<!\\|)\\|(?![\\|=])"
        },
        {
          "name": "keyword.operator.bitwise.nexa",
          "match": "(?<!\\^)\\^(?!=)"
        },
        {
          "name": "keyword.operator.logical.nexa",
          "match": "(?<!=)!(?!=)"
        },
        {
          "name": "keyword.operator.ternary.nexa",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.assignment.nexa",
          "match": "(?<![=!<>])=(?![=>])"
        },
        {
          "name": "keyword.operator.arithmetic.nexa",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.nexa",
          "match": "[,;:\\.]"
        },
        {
          "name": "punctuation.section.nexa",
          "match": "[\\(\\)\\{\\}\\[\\]]"
        }
      ]
    }
  }
}
