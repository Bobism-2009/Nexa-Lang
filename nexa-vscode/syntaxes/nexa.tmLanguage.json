{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nexa",
  "scopeName": "source.nexa",
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#builtin-modules" },
    { "include": "#raw-strings" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#inline-cpp" },
    { "include": "#struct-def" },
    { "include": "#enum-def" },
    { "include": "#function-def" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nexa",
          "match": "//[^\\n\\r]*"
        },
        {
          "name": "comment.block.nexa",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.include.angle.nexa",
          "begin": "^\\s*(#include)\\s*(<)",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.nexa" },
            "2": { "name": "punctuation.definition.string.begin.nexa" }
          },
          "end": "(>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.nexa" }
          },
          "patterns": [
            {
              "name": "meta.import.std.nexa",
              "match": "(std/)(io|os|dll|file|random|math|crypto|http|time|thread|inline)\\b",
              "captures": {
                "1": { "name": "keyword.other.import.prefix.nexa" },
                "2": { "name": "entity.name.namespace" }
              }
            },
            {
              "name": "meta.import.package.nexa",
              "match": "([A-Za-z_][A-Za-z0-9_-]*)(/)([A-Za-z_][A-Za-z0-9_-]*)",
              "captures": {
                "1": { "name": "entity.name.namespace" },
                "2": { "name": "punctuation.separator.path.nexa" },
                "3": { "name": "entity.name.namespace" }
              }
            },
            {
              "name": "entity.name.namespace",
              "match": "[A-Za-z_][A-Za-z0-9_-]*"
            }
          ]
        },
        {
          "name": "meta.preprocessor.include.quote.nexa",
          "begin": "^\\s*(#include)\\s*(\")",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.nexa" },
            "2": { "name": "punctuation.definition.string.begin.nexa" }
          },
          "end": "(\")",
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.nexa" }
          },
          "patterns": [
            {
              "name": "string.quoted.double.nexa",
              "match": "[^\"\\r\\n]+"
            }
          ]
        }
      ]
    },
    "raw-strings": {
      "patterns": [
        {
          "name": "string.quoted.double.raw.nexa",
          "begin": "R\"([^()\\\\\\\"\n]*)\\(",
          "end": "\\)\\1\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.nexa" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.nexa" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nexa",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nexa",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.nexa",
          "match": "'(?:\\\\.|[^'\\\\])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nexa",
          "match": "-?\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.float.nexa",
          "match": "-?\\b\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.nexa",
          "match": "-?\\b\\d+\\b"
        }
      ]
    },
    "inline-cpp": {
      "patterns": [
        {
          "name": "keyword.other.inline_cpp.nexa",
          "match": "\\binline_cpp\\s*!"
        }
      ]
    },
    "struct-def": {
      "patterns": [
        {
          "name": "meta.struct.nexa",
          "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.nexa" },
            "2": { "name": "entity.name.type.struct.nexa" }
          }
        }
      ]
    },
    "enum-def": {
      "patterns": [
        {
          "name": "meta.enum.nexa",
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.nexa" },
            "2": { "name": "entity.name.type.enum.nexa" }
          }
        }
      ]
    },
    "function-def": {
      "patterns": [
        {
          "name": "meta.function.extern.nexa",
          "match": "\\b(extern)\\s+(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "captures": {
            "1": { "name": "keyword.control.nexa" },
            "2": { "name": "keyword.control.nexa" },
            "3": { "name": "entity.name.function.nexa" },
            "4": { "name": "punctuation.definition.parameters.begin.nexa" }
          }
        },
        {
          "name": "meta.function.nexa",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "captures": {
            "1": { "name": "keyword.control.nexa" },
            "2": { "name": "entity.name.function.nexa" },
            "3": { "name": "punctuation.definition.parameters.begin.nexa" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.type.nexa",
          "match": "\\b(unsigned\\s+int|unsigned\\s+short|unsigned\\s+long|unsigned\\s+char|int|short|long|size_t|string|bool|float|char|void)\\b"
        },
        {
          "name": "storage.type.pointer.nexa",
          "match": "\\*+(?:int|string|char|void|float|bool|[A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "name": "keyword.control.nexa",
          "match": "\\b(fn|extern|new|delete|sizeof|let|const|struct|enum|if|else|while|for|switch|case|default|return|break|continue|goto|try|catch|throw)\\b"
        },
        {
          "name": "keyword.other.entry.nexa",
          "match": "\\b(main|__init__)\\b"
        },
        {
          "name": "constant.language.null.nexa",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.language.boolean.nexa",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.nexa",
          "match": "\\b(len|trim)(?=\\s*\\()"
        },
        {
          "name": "support.function.builtin.nexa",
          "match": "(?<=\\.)(upper|lower|trim|len|contains|starts_with|ends_with|index_of|replace|substring|repeat|split)(?=\\s*\\()"
        }
      ]
    },
    "builtin-modules": {
      "patterns": [
        {
          "name": "meta.module.access.nexa",
          "match": "\\b(io|os|dll|file|random|math|crypto|http|time|thread)\\.([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.namespace" },
            "2": { "name": "entity.name.function" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.shift.assign.nexa",
          "match": "<<=|>>="
        },
        {
          "name": "keyword.operator.bitwise.shift.nexa",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.nexa",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.nexa",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.assignment.bitwise.nexa",
          "match": "&=|\\|=|\\^="
        },
        {
          "name": "keyword.operator.assignment.nexa",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.increment.nexa",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.bitwise.nexa",
          "match": "~"
        },
        {
          "name": "keyword.operator.comparison.nexa",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.arrow.nexa",
          "match": "->"
        },
        {
          "name": "keyword.operator.address.nexa",
          "match": "(?<![&])&(?![&=])"
        },
        {
          "name": "keyword.operator.dereference.nexa",
          "match": "(?<![*])\\*(?![*=])"
        },
        {
          "name": "keyword.operator.ellipsis.nexa",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.bitwise.nexa",
          "match": "(?<!\\|)\\|(?![\\|=])"
        },
        {
          "name": "keyword.operator.bitwise.nexa",
          "match": "(?<!\\^)\\^(?!=)"
        },
        {
          "name": "keyword.operator.logical.nexa",
          "match": "(?<!=)!(?!=)"
        },
        {
          "name": "keyword.operator.assignment.nexa",
          "match": "(?<![=!<>])=(?!=)"
        },
        {
          "name": "keyword.operator.arithmetic.nexa",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.nexa",
          "match": "[,;:\\.]"
        },
        {
          "name": "punctuation.section.nexa",
          "match": "[\\(\\)\\{\\}\\[\\]]"
        }
      ]
    }
  }
}
