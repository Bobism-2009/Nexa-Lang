// Build with NexaC 0.1.4+ (or this repo). Older toolchains (before 0.1.4) may fail:
// raw R"(...)" strings, newer std/io/os/file, etc.
#include <std/io>
#include <std/os>
#include <std/file>

let title_ascii: string = R"( /$$   /$$                                /$$$$$$ 
| $$$ | $$                               /$$__  $$
| $$$$| $$  /$$$$$$  /$$   /$$  /$$$$$$ | $$  \__/
| $$ $$ $$ /$$__  $$|  $$ /$$/ |____  $$| $$      
| $$  $$$$| $$$$$$$$ \  $$$$/   /$$$$$$$| $$      
| $$\  $$$| $$_____/  >$$  $$  /$$__  $$| $$    $$
| $$ \  $$|  $$$$$$$ /$$/\  $$|  $$$$$$$|  $$$$$$/
|__/  \__/ \_______/|__/  \__/ \_______/ \______/ 
                                                  
                                                  
                                                  )";

let Plat = os.platform();

let mime_xml: string = R"(<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-nxa">
    <comment>Nexa Source File</comment>
    <glob pattern="*.nxa"/>
  </mime-type>
</mime-info>
)";

// Launch Services UTI helper (macOS has no freedesktop MIME database).
let darwin_uti_plist: string = R"(<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>NexaC</string>
  <key>CFBundleIdentifier</key>
  <string>org.nexa.nxa</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>Nexa Source</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Nexa Source File</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>org.nexa.nxa</string>
      </array>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>nxa</string>
      </array>
    </dict>
  </array>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.nexa.nxa</string>
      <key>UTTypeDescription</key>
      <string>Nexa Source File</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.source-code</string>
        <string>public.plain-text</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>nxa</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
)";

fn Register_Nxa_Mime_Linux_User() {
    let Home = os.getenv("HOME");
    let MimeDir = Home + "/.local/share/mime/packages";
    os.system("mkdir -p " + MimeDir);
    file.write(MimeDir + "/nxa.xml", mime_xml);
    os.system("update-mime-database " + Home + "/.local/share/mime 2>/dev/null");
}

fn Register_Nxa_Mime_Linux_System() {
    file.write("/tmp/nxa-mime.xml", mime_xml);
    os.system("sudo mkdir -p /usr/share/mime/packages");
    os.system("sudo cp /tmp/nxa-mime.xml /usr/share/mime/packages/nxa.xml");
    os.system("sudo update-mime-database /usr/share/mime 2>/dev/null");
}

fn Darwin_Lsregister(AppPath: string) {
    os.system("/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f \"" + AppPath + "\" 2>/dev/null");
}

fn Register_Nxa_Uti_Darwin_User(NexaCPath: string) {
    let Home = os.getenv("HOME");
    let App = Home + "/Library/Application Support/NexaC/Nexa Source.app";
    let Contents = App + "/Contents";
    os.system("mkdir -p \"" + Contents + "/MacOS\"");
    file.write(Contents + "/Info.plist", darwin_uti_plist);
    os.system("ln -sf \"" + NexaCPath + "\" \"" + Contents + "/MacOS/NexaC\"");
    Darwin_Lsregister(App);
}

fn Register_Nxa_Uti_Darwin_System(NexaCPath: string) {
    let App = "/Library/Application Support/NexaC/Nexa Source.app";
    file.write("/tmp/nexa-uti-Info.plist", darwin_uti_plist);
    os.system("sudo mkdir -p \"" + App + "/Contents/MacOS\"");
    os.system("sudo cp /tmp/nexa-uti-Info.plist \"" + App + "/Contents/Info.plist\"");
    os.system("sudo ln -sf \"" + NexaCPath + "\" \"" + App + "/Contents/MacOS/NexaC\"");
    Darwin_Lsregister(App);
}

fn Register_Nxa_Registry_Windows_User(ExePath: string) {
    os.system("reg add \"HKCU\\Software\\Classes\\.nxa\" /ve /d \"NexaC.SourceFile\" /f");
    os.system("reg add \"HKCU\\Software\\Classes\\NexaC.SourceFile\" /ve /d \"Nexa Source File\" /f");
    os.system("reg add \"HKCU\\Software\\Classes\\NexaC.SourceFile\\DefaultIcon\" /ve /d \"" + ExePath + ",0\" /f");
}

fn Register_Nxa_Registry_Windows_System(ExePath: string) {
    os.system("reg add \"HKLM\\Software\\Classes\\.nxa\" /ve /d \"NexaC.SourceFile\" /f");
    os.system("reg add \"HKLM\\Software\\Classes\\NexaC.SourceFile\" /ve /d \"Nexa Source File\" /f");
    os.system("reg add \"HKLM\\Software\\Classes\\NexaC.SourceFile\\DefaultIcon\" /ve /d \"" + ExePath + ",0\" /f");
}

fn Install_Clang_Linux() {
    // clang front-end + g++/libstdc++ so generated C++ links on a clean machine
    os.system("which clang++ >/dev/null 2>&1 && which g++ >/dev/null 2>&1 || (which apt-get >/dev/null 2>&1 && sudo apt-get update && sudo apt-get install -y clang g++ build-essential) || (which dnf >/dev/null 2>&1 && sudo dnf install -y clang gcc-c++) || (which pacman >/dev/null 2>&1 && sudo pacman -S --noconfirm clang gcc) || true");
}

fn Install_Clang_Darwin() {
    os.system("which clang++ >/dev/null 2>&1 || (xcode-select -p >/dev/null 2>&1 || xcode-select --install) || true");
}

fn Install_Toolchain_Windows() {
    // NexaC emits GNU-style link flags (-static-libgcc, -Wl,--gc-sections, -lwinhttp).
    // Stock LLVM.LLVM is often MSVC-target and fails alone — install MinGW g++ first, then clang.
    io.println("Installing MinGW g++ (required to link Nexa builds)...");
    os.system("where g++ >nul 2>&1 || (winget install --id BrechtSanders.WinLibs.POSIX.UCRT -e --accept-package-agreements --accept-source-agreements) || (winget install --id MSYS2.MSYS2 -e --accept-package-agreements --accept-source-agreements) || true");
    io.println("Installing LLVM clang (optional front-end; NexaC falls back to g++)...");
    os.system("where clang++ >nul 2>&1 || (winget install --id LLVM.LLVM -e --accept-package-agreements --accept-source-agreements) || true");
    // Ensure common MinGW bin dirs are on the user PATH for this and future shells.
    os.system("powershell -NoProfile -Command \"$dirs=@('C:\\mingw64\\bin','C:\\WinLibs\\mingw64\\bin','C:\\msys64\\ucrt64\\bin','C:\\msys64\\mingw64\\bin'); $p=[Environment]::GetEnvironmentVariable('Path','User'); if(-not $p){$p=''}; foreach($d in $dirs){ if((Test-Path $d) -and ($p -notlike ('*'+$d+'*'))){ $p=$p+';'+$d } }; [Environment]::SetEnvironmentVariable('Path',$p,'User'); $env:Path=$p+';'+$env:Path\"");
}

fn Add_To_Path_User_Linux() {
    let Home = os.getenv("HOME");
    os.system("grep -q '.local/bin' " + Home + "/.bashrc 2>/dev/null || echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> " + Home + "/.bashrc");
    os.system("grep -q '.local/bin' " + Home + "/.profile 2>/dev/null || echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> " + Home + "/.profile");
}

fn Add_To_Path_User_Darwin() {
    let Home = os.getenv("HOME");
    os.system("touch \"" + Home + "/.zprofile\" \"" + Home + "/.zshrc\" \"" + Home + "/.bash_profile\"");
    os.system("grep -q '.local/bin' \"" + Home + "/.zprofile\" 2>/dev/null || echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> \"" + Home + "/.zprofile\"");
    os.system("grep -q '.local/bin' \"" + Home + "/.zshrc\" 2>/dev/null || echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> \"" + Home + "/.zshrc\"");
    os.system("grep -q '.local/bin' \"" + Home + "/.bash_profile\" 2>/dev/null || echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> \"" + Home + "/.bash_profile\"");
}

fn Add_To_Path_Windows_User(InstallDir: string) {
    os.system("powershell -Command \"$p=[Environment]::GetEnvironmentVariable('Path','User'); if($p -notlike '*NexaC*'){[Environment]::SetEnvironmentVariable('Path',$p+';" + InstallDir + "','User')}\"");
}

fn Add_To_Path_Windows_System(InstallDir: string) {
    os.system("powershell -Command \"$p=[Environment]::GetEnvironmentVariable('Path','Machine'); if($p -notlike '*NexaC*'){[Environment]::SetEnvironmentVariable('Path',$p+';" + InstallDir + "','Machine')}\" 2>nul");
}

fn Is_Windows_Admin(): int {
    let r: string = os.system("powershell -NoProfile -Command \"if (([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { Write-Output 1 } else { Write-Output 0 }\"");
    if (r.contains("1")) {
        return 1;
    }
    return 0;
}

// If not elevated, show UAC prompt and relaunch with --system. Returns 1 if already admin (continue), 0 if relaunched/cancelled.
fn Ensure_Windows_Admin_Or_Relaunch(): int {
    if (Is_Windows_Admin() == 1) {
        return 1;
    }
    io.println("Administrator access is required for a system-wide install.");
    io.println("Windows will ask for permission (UAC)...");
    let dir: string = os.exe_dir();
    let exe: string = dir + "Installer.exe";
    if (!file.exists(exe)) {
        io.println("Error: could not find Installer.exe next to this program.");
        return 0;
    }
    // -Wait so this process stays up until the elevated install finishes (or UAC is denied).
    os.system("powershell -NoProfile -Command \"Start-Process -FilePath '" + exe + "' -ArgumentList '--system' -WorkingDirectory '" + dir + "' -Verb RunAs -Wait\"");
    return 0;
}

fn Menu() {
    io.println(title_ascii);
    io.println("\nWelcome to the NexaC Installer! Please choose an install option.\n");
    io.println("1. System-wide install & Set .nxa as Nexa Source File. (Requires Admin)");
    io.println("2. User install & Set .nxa as Nexa Source File.");
    io.println("");
    io.print("> ");
}

fn Install_System_Wide() {
    let ExeDir = os.exe_dir();
    if (Plat == "linux") {
        let Src = "";
        if (file.exists(ExeDir + "NexaC")) { Src = ExeDir + "NexaC"; }
        else if (file.exists("NexaC")) { Src = "NexaC"; }
        else if (file.exists("./NexaC")) { Src = "./NexaC"; }
        else if (file.exists("../NexaC")) { Src = "../NexaC"; }
        else if (file.exists("NexaC/NexaC")) { Src = "NexaC/NexaC"; }
        if (Src != "") {
        os.system("sudo mkdir -p /usr/local/bin");
        os.system("sudo cp \"" + Src + "\" /usr/local/bin/NexaC");
        os.system("sudo ln -sf NexaC /usr/local/bin/nexac");
        os.system("sudo ln -sf NexaC /usr/local/bin/nexapkg");
        Register_Nxa_Mime_Linux_System();
        io.println("Installing C++ toolchain (clang + g++)...");
        Install_Clang_Linux();
        io.println("NexaC installed to /usr/local/bin (in PATH). .nxa files recognized as Nexa Source File.");
        }
        else {
            io.println("Error: Cannot find NexaC. Run installer from folder containing NexaC.");
        }
    }
    else if (Plat == "darwin") {
        let Src = "";
        if (file.exists(ExeDir + "NexaC")) { Src = ExeDir + "NexaC"; }
        else if (file.exists("NexaC")) { Src = "NexaC"; }
        else if (file.exists("./NexaC")) { Src = "./NexaC"; }
        else if (file.exists("../NexaC")) { Src = "../NexaC"; }
        else if (file.exists("NexaC/NexaC")) { Src = "NexaC/NexaC"; }
        if (Src != "") {
        os.system("sudo mkdir -p /usr/local/bin");
        os.system("sudo cp \"" + Src + "\" /usr/local/bin/NexaC");
        os.system("sudo ln -sf NexaC /usr/local/bin/nexac");
        os.system("sudo ln -sf NexaC /usr/local/bin/nexapkg");
        Register_Nxa_Uti_Darwin_System("/usr/local/bin/NexaC");
        io.println("Installing Xcode Command Line Tools (clang)...");
        Install_Clang_Darwin();
        io.println("NexaC installed to /usr/local/bin (in PATH). .nxa registered as Nexa Source File (Launch Services UTI).");
        }
        else {
            io.println("Error: Cannot find NexaC. Run installer from folder containing NexaC.");
        }
    }
    else if (Plat == "windows") {
        let Src = "";
        if (file.exists(ExeDir + "NexaC.exe")) { Src = ExeDir + "NexaC.exe"; }
        else if (file.exists("NexaC.exe")) { Src = "NexaC.exe"; }
        else if (file.exists("NexaC\\NexaC.exe")) { Src = "NexaC\\NexaC.exe"; }
        else if (file.exists("WIN\\NexaC.exe")) { Src = "WIN\\NexaC.exe"; }
        if (Src != "") {
        os.system("mkdir \"C:\\Program Files\\NexaC\" 2>nul");
        os.system("copy /Y \"" + Src + "\" \"C:\\Program Files\\NexaC\\NexaC.exe\"");
        os.system("copy /Y \"" + Src + "\" \"C:\\Program Files\\NexaC\\nexac.exe\"");
        os.system("copy /Y \"" + Src + "\" \"C:\\Program Files\\NexaC\\nexapkg.exe\"");
        Register_Nxa_Registry_Windows_System("C:\\Program Files\\NexaC\\NexaC.exe");
        io.println("Installing C++ toolchain (MinGW g++ + clang via winget)...");
        Install_Toolchain_Windows();
        Add_To_Path_Windows_System("C:\\Program Files\\NexaC");
        io.println("NexaC installed to C:\\Program Files\\NexaC. Added to system PATH.");
        io.println("Restart the terminal (or sign out/in) so g++/clang are on PATH, then run: NexaC --version");
        }
        else {
            io.println("Error: Cannot find NexaC.exe. Run installer from folder containing NexaC.exe.");
        }
    }
    else {
        io.println("Platform Not Supported!");
    }
}

fn Install_User() {
    let ExeDir = os.exe_dir();
    if (Plat == "linux") {
        let Src = "";
        if (file.exists(ExeDir + "NexaC")) { Src = ExeDir + "NexaC"; }
        else if (file.exists("NexaC")) { Src = "NexaC"; }
        else if (file.exists("./NexaC")) { Src = "./NexaC"; }
        else if (file.exists("../NexaC")) { Src = "../NexaC"; }
        else if (file.exists("NexaC/NexaC")) { Src = "NexaC/NexaC"; }
        if (Src != "") {
        os.system("mkdir -p ~/.local/bin");
        os.system("cp \"" + Src + "\" ~/.local/bin/NexaC");
        os.system("ln -sf NexaC ~/.local/bin/nexac");
        os.system("ln -sf NexaC ~/.local/bin/nexapkg");
        Register_Nxa_Mime_Linux_User();
        io.println("Installing C++ toolchain (clang + g++)...");
        Install_Clang_Linux();
        Add_To_Path_User_Linux();
        io.println("NexaC installed to ~/.local/bin. Added to PATH in ~/.bashrc and ~/.profile. Restart terminal or run: source ~/.bashrc");
        }
        else {
            io.println("Error: Cannot find NexaC. Run installer from folder containing NexaC.");
        }
    }
    else if (Plat == "darwin") {
        let Src = "";
        if (file.exists(ExeDir + "NexaC")) { Src = ExeDir + "NexaC"; }
        else if (file.exists("NexaC")) { Src = "NexaC"; }
        else if (file.exists("./NexaC")) { Src = "./NexaC"; }
        else if (file.exists("../NexaC")) { Src = "../NexaC"; }
        else if (file.exists("NexaC/NexaC")) { Src = "NexaC/NexaC"; }
        if (Src != "") {
        os.system("mkdir -p ~/.local/bin");
        os.system("cp \"" + Src + "\" ~/.local/bin/NexaC");
        os.system("ln -sf NexaC ~/.local/bin/nexac");
        os.system("ln -sf NexaC ~/.local/bin/nexapkg");
        Register_Nxa_Uti_Darwin_User(os.getenv("HOME") + "/.local/bin/NexaC");
        io.println("Installing Xcode Command Line Tools (clang)...");
        Install_Clang_Darwin();
        Add_To_Path_User_Darwin();
        io.println("NexaC installed to ~/.local/bin. Added ~/.local/bin to PATH in ~/.zprofile, ~/.zshrc, and ~/.bash_profile. Restart the terminal.");
        }
        else {
            io.println("Error: Cannot find NexaC. Run installer from folder containing NexaC.");
        }
    }
    else if (Plat == "windows") {
        let Src = "";
        if (file.exists(ExeDir + "NexaC.exe")) { Src = ExeDir + "NexaC.exe"; }
        else if (file.exists("NexaC.exe")) { Src = "NexaC.exe"; }
        else if (file.exists("NexaC\\NexaC.exe")) { Src = "NexaC\\NexaC.exe"; }
        else if (file.exists("WIN\\NexaC.exe")) { Src = "WIN\\NexaC.exe"; }
        if (Src != "") {
        let LocalAppData = os.getenv("LOCALAPPDATA");
        let ExePath = LocalAppData + "\\NexaC\\NexaC.exe";
        os.system("mkdir \"" + LocalAppData + "\\NexaC\" 2>nul");
        os.system("copy /Y \"" + Src + "\" \"" + LocalAppData + "\\NexaC\\NexaC.exe\"");
        os.system("copy /Y \"" + Src + "\" \"" + LocalAppData + "\\NexaC\\nexac.exe\"");
        os.system("copy /Y \"" + Src + "\" \"" + LocalAppData + "\\NexaC\\nexapkg.exe\"");
        Register_Nxa_Registry_Windows_User(ExePath);
        io.println("Installing C++ toolchain (MinGW g++ + clang via winget)...");
        Install_Toolchain_Windows();
        Add_To_Path_Windows_User(LocalAppData + "\\NexaC");
        io.println("NexaC installed to " + LocalAppData + "\\NexaC. Added to PATH.");
        io.println("Restart the terminal (or sign out/in) so g++/clang are on PATH, then run: NexaC --version");
        }
        else {
            io.println("Error: Cannot find NexaC.exe. Run installer from folder containing NexaC.exe.");
        }
    }
    else {
        io.println("Platform Not Supported!");
    }
}

fn main(args: []string) {
    // Elevated relaunch path: skip the menu and install system-wide.
    if (len(args) >= 2) {
        if (args[1] == "--system") {
            io.println(title_ascii);
            io.println("\nInstalling NexaC system-wide (administrator)...");
            io.println("Detected OS: " + Plat + "\n");
            Install_System_Wide();
            io.println("\nPress Enter to close...");
            let blank: string = io.readln();
            return;
        }
    }

    Menu();
    let Choice: string = io.readln();
    let Choice_Int = io.to_int(Choice);

    switch (Choice_Int) {
        case 1:
            io.println("Installing NexaC system-wide...");
            io.println("\nDetected OS: " + Plat);
            if (Plat == "windows") {
                if (Ensure_Windows_Admin_Or_Relaunch() == 0) {
                    // Elevated child ran the install (or UAC was cancelled).
                    return;
                }
            }
            Install_System_Wide();
            break;
        case 2:
            io.println("Installing NexaC to User...");
            io.println("\nDetected OS: " + Plat);
            Install_User();
            break;
        default:
            io.println("\nInvalid Option!");
            io.println("Please Re-Run Installer.");
            while (true) {
                let Blank = io.readln();
            }
    }
}