// A lamp in a dim room. The sun still casts. The lamp does not.
//
//   build: NexaC lamp.nxa -o lamp
//   drive: arrows orbit, W/S height, wheel zooms
//          J/L and I/K slide the lamp, R/F raise and lower it, escape quits
//
// It starts in the red pillar's shadow. Move it and the bright patch follows,
// including while that patch is still in the shade.
#include <std/gfx3d>
#include <std/io>
#include <std/math>

fn casters(): int {
    gfx3d.box(-2.2, 0.9, -0.4, 0.55, 1.8, 0.55, 180, 70, 70);
    gfx3d.sphere(0.4, 0.7, 0.6, 0.7, 210, 170, 90);
    gfx3d.cube(2.0, 0.5, 1.2, 1.0, 70, 120, 170);
    return 0;
}

fn main() {
    if (gfx3d.open("Lamp", 900, 620) != 1) {
        io.println("no 3D window: this platform has no backend yet");
        return;
    }
    gfx3d.perspective(55.0, 0.1, 80.0);
    gfx3d.maxfps(60);
    gfx3d.light(-0.4, 0.85, 0.3);
    gfx3d.ambient(36);

    let lx = -1.0;
    let ly = 0.85;
    let lz = -1.3;
    let angle = 0.7;
    let height = 3.4;
    let dist = 9.0;
    io.println("J/L I/K move the lamp, R/F its height. Arrows orbit, escape quits.");

    while (gfx3d.closed() != 1) {
        gfx3d.poll();
        if (gfx3d.key("left"))  { angle = angle - 0.02; }
        if (gfx3d.key("right")) { angle = angle + 0.02; }
        if (gfx3d.key("w"))     { height = height + 0.08; }
        if (gfx3d.key("s"))     { height = height - 0.08; }
        dist = dist - gfx3d.wheel() * 0.45;
        if (dist < 4.0) { dist = 4.0; }
        if (dist > 22.0) { dist = 22.0; }
        if (gfx3d.key("j")) { lx = lx - 0.06; }
        if (gfx3d.key("l")) { lx = lx + 0.06; }
        if (gfx3d.key("i")) { lz = lz - 0.06; }
        if (gfx3d.key("k")) { lz = lz + 0.06; }
        if (gfx3d.key("r")) { ly = ly + 0.05; }
        if (gfx3d.key("f")) { ly = ly - 0.05; }
        if (ly < 0.2) { ly = 0.2; }
        if (gfx3d.pressed("escape")) { gfx3d.close(); }

        gfx3d.lamp(lx, ly, lz, 4.2, 255, 196, 120);
        gfx3d.camera(math.sin(angle) * dist, height, math.cos(angle) * dist,
                     -0.2, 0.4, 0.1);

        gfx3d.shadow();
        gfx3d.clear(24, 28, 38);
        casters();
        gfx3d.shadow();

        gfx3d.clear(24, 28, 38);
        gfx3d.box(0.0, -0.5, 0.0, 16.0, 1.0, 16.0, 170, 164, 152);
        gfx3d.grid(16.0, 1.0, 120, 132, 148);
        casters();
        gfx3d.sphere(lx, ly, lz, 0.12, 255, 230, 180);
        gfx3d.present();
    }

    gfx3d.close();
}
