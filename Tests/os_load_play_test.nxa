#include <std/file>
#include <std/io>
#include <std/os>

fn main() {
    let dir: string = os.tempdir();
    let path: string = file.join(dir, "_nexa_os_load.bin");
    file.write(path, "hello-bin-ok");
    let got: string = os.load(path);
    if (got != "hello-bin-ok") {
        io.println("fail load content");
        return 1;
    }
    if (len(got) != 12) {
        io.println("fail load len");
        return 2;
    }
    if (os.load(file.join(dir, "_nexa_os_load_missing_xyz.bin")) != "") {
        io.println("fail missing");
        return 3;
    }
    if (os.play("") != 0) {
        io.println("fail play empty");
        return 4;
    }
    if (os.play(file.join(dir, "_nexa_os_play_missing_xyz.wav")) != 0) {
        io.println("fail play missing");
        return 5;
    }
    let raw: string = "\x00\x0a\x0d\xffSAVE";
    let savePath: string = file.join(dir, "_nexa_os_save.bin");
    if (os.save(savePath, raw) != 1) {
        io.println("fail save write");
        return 6;
    }
    if (os.load(savePath) != raw) {
        io.println("fail save load");
        return 7;
    }
    if (os.save(file.join(dir, "missing_os_save_dir/nope.bin"), raw) != 0) {
        io.println("fail save missing dir");
        return 8;
    }
    file.remove(savePath);
    io.println("ok");
    return 0;
}
