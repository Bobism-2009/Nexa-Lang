#include <std/io>

fn main() {
    let i = 0;

start:
    if (i >= 5) {
        goto done;
    }
    io.println("i = " + i);
    i = i + 1;
    goto start;

done:
    io.println("loop finished");

    // forward jump skipping a statement
    goto skip;
    io.println("this should NOT print");
skip:
    io.println("jumped over the skipped line");
}
