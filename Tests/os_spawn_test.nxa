#include <std/io>
#include <std/os>

fn main() {
    let pid: int = 0;
    if (os.platform() == "windows") {
        pid = os.spawn("cmd", "/c", "exit", "0");
        os.spawn("cmd", "/c", "exit", "0");
    } else {
        pid = os.spawn("true");
        os.spawn("true");
    }
    if (pid > 0) {
        io.println("ok");
        io.println(pid);
    } else {
        io.println("fail");
    }
}
