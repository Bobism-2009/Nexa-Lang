// Drives the ALSA backend behind gfx.audio() through the public API (BOB-41).
//
// Run by Tests/gfx_alsa_cases.sh, once per device the fake libasound in
// Tests/gfx_alsa_stub is told to be: one that works, one that will not open,
// one that is full, one that underruns, and none at all. Everything this prints
// is a contract value the suite checks, and the fake library writes a trace of
// what the backend asked it for alongside.
//
// No window is ever opened: the audio stream is not owned by the window, which
// is itself worth pinning here.

#include <std/gfx>
#include <std/io>

fn main() {
    let ok: int = gfx.audio(22050);
    io.println("audio=" + ok);

    let q0: int = gfx.audio_queued();
    io.println("queued0=" + q0);

    // 3000 samples is one full 2048-sample buffer handed to the device and 952
    // left staged, so the two halves of gfx.audio_queued() -- what the device
    // holds and what has not been written yet -- both have to be counted for
    // this to come to 3000.
    let fed: int = 0;
    let i: int = 0;
    while (i < 3000) {
        fed = fed + gfx.sample(1000);
        i = i + 1;
    }
    io.println("fed=" + fed);

    let q1: int = gfx.audio_queued();
    io.println("queued1=" + q1);

    // A flush submits the partial buffer, which moves the staged samples over
    // to the device without changing the total.
    let f: int = gfx.audio_flush();
    io.println("flush=" + f);
    let q2: int = gfx.audio_queued();
    io.println("queued2=" + q2);

    // Asking for the rate already open is not a reopen.
    let again: int = gfx.audio(22050);
    io.println("again=" + again);
    let q3: int = gfx.audio_queued();
    io.println("queued3=" + q3);

    gfx.close();

    // Closed: the stream is gone, so nothing is queued and no sample is taken.
    let after: int = gfx.sample(1000);
    io.println("after=" + after);
    io.println("queued4=" + gfx.audio_queued());
    io.println("done");
}
