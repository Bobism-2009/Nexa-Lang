#include <std/io>

fn main() {
    let n: int = 42;
    let f: float = 3.5;
    let c: char = 'Z';
    let b: bool = true;
    let s: string = "mid";
    io.println("n=" + n);
    io.println("f=" + f);
    io.println("c=" + c);
    io.println("b=" + b);
    io.println("left" + s + "right");
    io.println(1 + 2 + " tail");
    return 0;
}
