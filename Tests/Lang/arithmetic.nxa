// Pins Nexa arithmetic: operator precedence, bitwise operators, integer vs
// float division, and C-style casts.
// Reference: SYNTAX/Core.txt (ARITHMETIC, CASTS)
#include <std/io>

fn main() {
    // Precedence, tightest first:  * / %  ;  + -  ;  << >>  ;  &  ;  ^  ;  |
    io.println("mul_over_add=", 2 + 3 * 4);          // 2 + 12
    io.println("div_over_sub=", 20 - 12 / 4);        // 20 - 3
    io.println("mod_over_add=", 1 + 7 % 4);          // 1 + 3
    io.println("add_over_shift=", 1 + 1 << 3);       // (2) << 3
    io.println("shift_over_and=", 1 << 2 & 6);       // (4) & 6
    io.println("and_over_xor=", 1 ^ 3 & 2);          // 1 ^ (2)
    io.println("xor_over_or=", 4 | 3 ^ 1);           // 4 | (2)
    io.println("parens_win=", (2 + 3) * 4);

    // Left associativity within a tier.
    io.println("sub_left_assoc=", 10 - 3 - 2);       // (10-3)-2, not 10-(3-2)
    io.println("div_left_assoc=", 100 / 5 / 2);      // (100/5)/2
    io.println("shift_left_assoc=", 64 >> 2 >> 1);   // (64>>2)>>1

    // Integer division truncates toward zero; % takes the dividend's sign.
    io.println("int_div=", 7 / 2);
    io.println("int_div_neg=", -7 / 2);
    io.println("mod_pos=", 7 % 3);
    io.println("mod_neg_lhs=", -7 % 3);
    io.println("mod_neg_rhs=", 7 % -3);

    // Bitwise, including unary NOT and a negative right shift subject.
    io.println("bit_and=", 12 & 10);
    io.println("bit_or=", 12 | 10);
    io.println("bit_xor=", 12 ^ 10);
    io.println("bit_not=", ~0);
    io.println("bit_not_five=", ~5);
    io.println("shl=", 3 << 4);
    io.println("shr=", 256 >> 4);

    // Unary minus, and unary binding tighter than binary.
    let n = 5;
    io.println("neg=", -n);
    io.println("neg_neg=", - -n);
    io.println("neg_binds_tight=", -n * 2);          // (-5) * 2

    // int + float promotes to float.
    let i = 3;
    let f = 0.5;
    io.println("int_plus_float=", i + f);
    io.println("float_div=", 7.0 / 2.0);
    io.println("float_whole=", 4.0 / 2.0);           // does a whole float keep a ".0"?
    io.println("leading_dot=", .5 + .25);

    // C-style casts share unary precedence.
    let x: float = 3.7;
    io.println("cast_int=", (int)x);
    io.println("cast_int_neg=", (int)-3.7);
    io.println("cast_char=", (char)65);
    io.println("cast_string=", (string)42);
    io.println("cast_parse=", (int)"42");
    io.println("cast_float_of_int=", (float)7 / 2);
    io.println("cast_bool_true=", (bool)5);
    io.println("cast_bool_false=", (bool)0);
    io.println("cast_uchar_wrap=", (int)(unsigned char)300);

    // Mixed-width arithmetic keeps the wider type. Note the "+" (string) form:
    // io.println(big + 1) on its own still narrows to %d — see
    // Tests/Lang/known_bugs/wide_int_println.nxa.
    let big: long = 3000000000;
    io.println("long_value=", big);
    io.println("long_add=" + (big + 1));
    io.println("long_mul=" + (big * 3));
    let u: unsigned int = 4294967295;
    io.println("uint_max=", u);
}
