// random.float / bool / chance / choice / shuffle under a seed: like random.int,
// the same seed gives the same answers on every platform, because how the
// generator's bits become a float or an order is Nexa's own arithmetic.
// Reference: SYNTAX/Modules.txt (std/random)
#include <std/io>
#include <std/random>

struct Deck {
    cards: []int;
}

fn main() {
    random.seed(42);
    io.println("float=", random.float(), " ", random.float());
    let f = random.float(10, 20);
    io.println("range=", f, " inside=", f >= 10.0 && f < 20.0);
    io.println("swapped=", random.float(5.0, -5.0));

    random.seed(7);
    let flips: string = "";
    for (i, 16) {
        if (random.bool()) { flips = flips + "H"; } else { flips = flips + "T"; }
    }
    io.println("flips=", flips);
    let hits = 0;
    for (i, 1000) {
        if (random.chance(0.25)) { hits++; }
    }
    let never = random.chance(0);
    io.println("chance=", hits, " never=", never, " always=", random.chance(1));

    random.seed(3);
    let names = ["ada", "bob", "cy", "dee"];
    let picked: string = "";
    for (i, 6) { picked = picked + random.choice(names) + " "; }
    io.println("choice=", picked);
    let one = random.choice(names);
    io.println("one=", one, " len=", one.len());
    let nums = [10, 20, 30];
    let sum = random.choice(nums) + random.choice(nums);
    io.println("sum=", sum);
    let only = [99];
    io.println("only=", random.choice(only));

    random.seed(11);
    let xs = [1, 2, 3, 4, 5, 6, 7, 8];
    random.shuffle(xs);
    io.println("shuffle=", xs);
    random.shuffle(names);
    io.println("names=", names);
    let flags = [true, false, false, true, false];
    random.shuffle(flags);
    io.println("flags=", flags);
    let d = Deck{cards: [1, 2, 3, 4, 5]};
    random.shuffle(d.cards);
    io.println("deck=", d.cards, " top=", random.choice(d.cards));
    let empty: []int = [];
    random.shuffle(empty);
    io.println("empty=", len(empty));

    random.seed(42);
    io.println("again=", random.float());
}
