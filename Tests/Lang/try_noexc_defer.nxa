// try / catch / throw as NexaC's own errors, not C++ exceptions: defer runs as an error leaves a function.
// Each case prints what the exception version printed (checked against it).
// Reference: SYNTAX/ControlFlow.txt ("ERRORS: TRY / CATCH / THROW")
#include <std/io>
fn work(n: int): string {
    defer io.println("cleanup ", n);
    if (n == 2) { throw "failed at " + n; }
    return "ok " + n;
}
fn main() {
    for (i in 1..3) {
        try { io.println(work(i)); } catch (e) { io.println("caught ", e); }
    }
}
