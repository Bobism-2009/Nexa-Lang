// KNOWN NEXAC BUG: io.println(<expression of a type wider than int>) is
// emitted as printf("%d\n", expr), so the value is read back as 32 bits.
//
//   io.println(big)      -> correct   (the variable case picks the right format)
//   io.println(big + 1)  -> wrong     (the expression case falls back to %d)
//
// clang says so out loud: "format specifies type 'int' but the argument has
// type 'long' [-Wformat]". The "+" (string concatenation) spelling is fine,
// which is why Tests/Lang/arithmetic.nxa uses it.
//
// Affects: long, unsigned long, size_t. Delete this file and fold the cases
// back into arithmetic.nxa / int_literals.nxa once NexaC picks the format
// from the expression's type.
#include <std/io>

fn main() {
    let big: long = 3000000000;
    io.println("long_add=", big + 1);

    let s: size_t = 5000000000;
    io.println("size_t_add=", s + 1);

    let u: unsigned long = 5000000000;
    io.println("ulong_add=", u + 1);
}
