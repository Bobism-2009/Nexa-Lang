// KNOWN NEXAC BUG: a `let` inside a switch case emits an unbraced C++
// declaration in the switch body, so clang refuses the whole program:
//
//   error: cannot jump from switch statement to this case label
//   note: jump bypasses variable initialization
//
// The generated case body needs its own { } (or the declaration has to be
// hoisted). Either way the user should never see a C++ diagnostic about
// generated code -- if the form is meant to be illegal it should be a
// "[Nexa] Error:" naming the .nxa line, the way stray break/continue is.
//
// SYNTAX/ControlFlow.txt does not say a case body may not declare a variable.
#include <std/io>

fn main() {
    switch (1) {
        case 1:
            let a = 11;
            io.println("case1=", a);
            break;
        default:
            io.println("default=0");
    }
}
