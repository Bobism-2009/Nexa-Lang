#include <std/io>

enum Color {
  Red;
  Green;
  Blue;
}

fn main() {
  let c: enum Color = Color.Green;
  io.println(c);
  if (c == Color.Green) {
    io.println(1);
  } else {
    io.println(0);
  }
  switch (c) {
    case Color.Red:
      io.println(10);
      break;
    case Color.Green:
      io.println(20);
      break;
    case Color.Blue:
      io.println(30);
      break;
    default:
      io.println(99);
      break;
  }
}
