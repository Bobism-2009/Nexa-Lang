#include <std/gfx>
#include <std/io>
#include <std/os>

fn main() {
    if (gfx.open("nexa-gfx-test", 8, 8, 2) != 1) {
        io.println("fail open");
        return 1;
    }
    if (gfx.title() != "nexa-gfx-test") {
        io.println("fail title get");
        gfx.close();
        return 26;
    }
    if (gfx.title("nexa-gfx-renamed") != 1) {
        io.println("fail title set");
        gfx.close();
        return 27;
    }
    if (gfx.title() != "nexa-gfx-renamed") {
        io.println("fail title after set");
        gfx.close();
        return 28;
    }
    gfx.clear(10, 20, 30);
    gfx.plot(2, 3, 255, 0, 0);
    gfx.fill(0, 0, 3, 2, 0, 255, 0);
    gfx.fill(6, 1, -2, 2, 0, 0, 255);
    gfx.line(0, 0, 7, 7, 255, 255, 0);
    gfx.line(-4, 3, 20, 3, 255, 0, 255);
    gfx.poll();
    gfx.present();
    gfx.plot(1, 6, 1, 2, 3);
    if (gfx.get(1, 6) != 66051) {
        io.println("fail get plot");
        gfx.close();
        return 19;
    }
    if (gfx.get(7, 0) != 660510) {
        io.println("fail get clear");
        gfx.close();
        return 20;
    }
    if (gfx.get(-1, 0) != -1 || gfx.get(8, 0) != -1) {
        io.println("fail get oob");
        gfx.close();
        return 21;
    }
    if (gfx.key("escape") != 0 && gfx.key("escape") != 1) {
        io.println("fail key");
        gfx.close();
        return 2;
    }
    if (gfx.key("shift") != 0 && gfx.key("shift") != 1) {
        io.println("fail key shift");
        gfx.close();
        return 29;
    }
    if (gfx.pressed("escape") != 0 && gfx.pressed("escape") != 1) {
        io.println("fail pressed");
        gfx.close();
        return 30;
    }
    if (gfx.pressed("nope") != 0) {
        io.println("fail pressed unknown");
        gfx.close();
        return 31;
    }
    let mx: int = gfx.mouse_x();
    let my: int = gfx.mouse_y();
    if (mx < 0 || my < 0 || mx >= 8 || my >= 8) {
        io.println("fail mouse pos");
        gfx.close();
        return 4;
    }
    if (gfx.mouse("left") != 0 && gfx.mouse("left") != 1) {
        io.println("fail mouse left");
        gfx.close();
        return 5;
    }
    if (gfx.mouse("right") != 0 && gfx.mouse("right") != 1) {
        io.println("fail mouse right");
        gfx.close();
        return 6;
    }
    if (gfx.mouse("middle") != 0 && gfx.mouse("middle") != 1) {
        io.println("fail mouse middle");
        gfx.close();
        return 7;
    }
    if (gfx.mouse("nope") != 0) {
        io.println("fail mouse unknown");
        gfx.close();
        return 8;
    }
    if (gfx.width() != 8 || gfx.height() != 8 || gfx.scale() != 2) {
        io.println("fail size open");
        gfx.close();
        return 10;
    }
    if (gfx.resize(32, 16) != 1) {
        io.println("fail resize keep scale");
        gfx.close();
        return 11;
    }
    if (gfx.width() != 32 || gfx.height() != 16 || gfx.scale() != 2) {
        io.println("fail size after resize");
        gfx.close();
        return 12;
    }
    if (gfx.resize(64, 48, 1) != 1) {
        io.println("fail resize scale");
        gfx.close();
        return 13;
    }
    if (gfx.width() != 64 || gfx.height() != 48 || gfx.scale() != 1) {
        io.println("fail size after scale");
        gfx.close();
        return 14;
    }
    if (gfx.text_width("Ok") != 12 || gfx.text_height("Ok") != 8) {
        io.println("fail text measure");
        gfx.close();
        return 23;
    }
    if (gfx.text_width("A\nBB") != 12 || gfx.text_height("A\nB") != 16) {
        io.println("fail text measure nl");
        gfx.close();
        return 24;
    }
    if (gfx.text_width("Hi", 2) != 24 || gfx.text_height("Hi", 2) != 16) {
        io.println("fail text measure scale");
        gfx.close();
        return 25;
    }
    if (gfx.text(1, 1, "Ok", 255, 255, 255) != 12) {
        io.println("fail text width");
        gfx.close();
        return 18;
    }
    gfx.text(1, 10, "A\nB", 200, 200, 200);
    gfx.text(1, 28, "Hi", 255, 255, 0, 2);
    if (gfx.text_size() != 1) {
        io.println("fail text_size default");
        gfx.close();
        return 16;
    }
    if (gfx.text_size(3) != 3 || gfx.text_size() != 3) {
        io.println("fail text_size set");
        gfx.close();
        return 17;
    }
    gfx.text(20, 1, "Sz", 255, 0, 255);
    if (gfx.decode("not-an-image") != 0) {
        io.println("fail decode junk");
        gfx.close();
        return 32;
    }
    if (gfx.image("nexa_missing_image_xyz.png") != 0) {
        io.println("fail image missing");
        gfx.close();
        return 33;
    }
    let pngPath: string = "Tests/gfx_2x2.png";
    if (os.load(pngPath) == "") {
        pngPath = "gfx_2x2.png";
    }
    let img: int = gfx.decode(os.load(pngPath));
    if (img == 0 || gfx.image_w(img) != 2 || gfx.image_h(img) != 2) {
        io.println("fail decode png size");
        gfx.close();
        return 34;
    }
    gfx.clear(0, 0, 0);
    if (gfx.blit(0, 0, img) != 1) {
        io.println("fail blit png");
        gfx.close();
        return 35;
    }
    if (gfx.get(0, 0) != 16711680 || gfx.get(1, 0) != 65280 || gfx.get(0, 1) != 255 || gfx.get(1, 1) != 16777215) {
        io.println("fail blit png pixels");
        gfx.close();
        return 36;
    }
    let bmpPath: string = "Tests/gfx_2x2.bmp";
    if (os.load(bmpPath) == "") {
        bmpPath = "gfx_2x2.bmp";
    }
    let imgBmp: int = gfx.decode(os.load(bmpPath));
    if (imgBmp == 0 || gfx.image_w(imgBmp) != 2 || gfx.image_h(imgBmp) != 2) {
        io.println("fail decode bmp size");
        gfx.close();
        return 37;
    }
    gfx.clear(0, 0, 0);
    gfx.blit(10, 10, imgBmp);
    if (gfx.get(10, 10) != 16711680 || gfx.get(11, 11) != 16777215) {
        io.println("fail blit bmp pixels");
        gfx.close();
        return 38;
    }
    let filePng: int = gfx.image(pngPath);
    if (filePng == 0 || gfx.image_w(filePng) != 2 || gfx.image_h(filePng) != 2) {
        io.println("fail image png file");
        gfx.close();
        return 39;
    }
    let jpgPath: string = "Tests/gfx_2x2.jpg";
    if (os.load(jpgPath) == "") {
        jpgPath = "gfx_2x2.jpg";
    }
    let fileJpg: int = gfx.image(jpgPath);
    if (fileJpg == 0 || gfx.image_w(fileJpg) != 2 || gfx.image_h(fileJpg) != 2) {
        io.println("fail image jpg file");
        gfx.close();
        return 40;
    }
    gfx.clear(0, 0, 0);
    if (gfx.blit(0, 0, img, 4, 4) != 1) {
        io.println("fail blit scale");
        gfx.close();
        return 41;
    }
    if (gfx.get(0, 0) != 16711680 || gfx.get(1, 0) != 16711680 || gfx.get(2, 0) != 65280 || gfx.get(3, 3) != 16777215) {
        io.println("fail blit scale pixels");
        gfx.close();
        return 42;
    }
    gfx.clear(0, 0, 0);
    if (gfx.blit(5, 6, img, 1, 0, 1, 1) != 1) {
        io.println("fail blit sprite");
        gfx.close();
        return 46;
    }
    if (gfx.get(5, 6) != 65280) {
        io.println("fail blit sprite pixel");
        gfx.close();
        return 47;
    }
    if (gfx.get(6, 6) != 0) {
        io.println("fail blit sprite neighbor");
        gfx.close();
        return 48;
    }
    gfx.clear(0, 0, 0);
    if (gfx.blit(0, 0, img, 0, 0, 2, 1, 4, 2) != 1) {
        io.println("fail blit sprite scale");
        gfx.close();
        return 49;
    }
    if (gfx.get(0, 0) != 16711680 || gfx.get(1, 0) != 16711680 || gfx.get(2, 0) != 65280 || gfx.get(3, 1) != 65280) {
        io.println("fail blit sprite scale pixels");
        gfx.close();
        return 50;
    }
    gfx.clear(0, 0, 0);
    if (gfx.blit(2, 2, pngPath, 0, 1, 1, 1) != 1) {
        io.println("fail blit sprite path");
        gfx.close();
        return 51;
    }
    if (gfx.get(2, 2) != 255) {
        io.println("fail blit sprite path pixel");
        gfx.close();
        return 52;
    }
    gfx.clear(0, 0, 0);
    if (gfx.blit(0, 0, img, 1, 0, 4, 1) != 1) {
        io.println("fail blit sprite clip");
        gfx.close();
        return 53;
    }
    if (gfx.get(0, 0) != 65280 || gfx.get(1, 0) != 0) {
        io.println("fail blit sprite clip pixels");
        gfx.close();
        return 54;
    }
    if (gfx.blit(0, 0, img, 8, 8, 1, 1) != 0) {
        io.println("fail blit sprite oob");
        gfx.close();
        return 55;
    }
    if (gfx.image_w(0) != 0 || gfx.image_h(-1) != 0) {
        io.println("fail image size invalid");
        gfx.close();
        return 43;
    }
    gfx.close();
    if (gfx.resize(10, 10) != 0 || gfx.width() != 0 || gfx.height() != 0 || gfx.scale() != 0) {
        io.println("fail size after close");
        return 15;
    }
    if (gfx.mouse_x() != 0 || gfx.mouse_y() != 0 || gfx.mouse("left") != 0) {
        io.println("fail mouse after close");
        return 9;
    }
    if (gfx.get(0, 0) != -1) {
        io.println("fail get after close");
        return 22;
    }
    if (gfx.image_w(img) != 2 || gfx.image_h(img) != 2) {
        io.println("fail image after close");
        return 44;
    }
    if (gfx.blit(0, 0, img) != 0) {
        io.println("fail blit after close");
        return 45;
    }
    if (gfx.closed() != 1) {
        io.println("fail closed");
        return 3;
    }
    io.println("ok");
    return 0;
}
