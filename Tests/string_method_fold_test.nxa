#include <std/io>

fn main() {
    if ("Hello".lower() != "hello") { io.println("lower fail"); return 1; }
    if ("Hello".upper() != "HELLO") { io.println("upper fail"); return 2; }
    if ("  hi  ".trim() != "hi") { io.println("trim fail"); return 3; }
    if ("abc".len() != 3) { io.println("len fail"); return 4; }
    if ("hello".contains("ell") != true) { io.println("contains fail"); return 5; }
    if ("hello".starts_with("he") != true) { io.println("starts fail"); return 6; }
    if ("hello".ends_with("lo") != true) { io.println("ends fail"); return 7; }
    if ("hello".index_of("ll") != 2) { io.println("index fail"); return 8; }
    if ("ab".repeat(3) != "ababab") { io.println("repeat fail"); return 9; }
    if ("aa-aa".replace("aa", "b") != "b-b") { io.println("replace fail"); return 10; }
    if ("hello".substring(1, 3) != "ell") { io.println("substr fail"); return 11; }
    io.println("fold ok");
    return 0;
}
