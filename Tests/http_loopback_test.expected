chunked true [hello, world]
redir true [GET|]
postredir true [GET|]
loop false [too many redirects]
echo true [POST|P|t1|application/json]
put true [PUT|U|-|application/octet-stream]
patch true [PATCH|A|t2|application/octet-stream]
delete true [DELETE||t3|-]
get true [GET||-|-]
404 false [HTTP 404]
request404 true 404 [missing]
extra true [ok]
request 200 [POST|B|t4|application/octet-stream]
echo-header 1
dead false [could not connect]
