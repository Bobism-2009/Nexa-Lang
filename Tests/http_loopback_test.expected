chunked 1 [hello, world]
redir 1 [GET|]
postredir 1 [GET|]
loop 0 [too many redirects]
echo 1 [POST|P|t1|application/json]
put 1 [PUT|U|-|application/octet-stream]
patch 1 [PATCH|A|t2|application/octet-stream]
delete 1 [DELETE||t3|-]
get 1 [GET||-|-]
404 0 [HTTP 404]
request404 1 404 [missing]
extra 1 [ok]
request 200 [POST|B|t4|application/octet-stream]
echo-header 1
dead 0 [could not connect]
