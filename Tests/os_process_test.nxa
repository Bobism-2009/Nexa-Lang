#include <std/io>
#include <std/os>

fn main() {
    let plat = os.platform();
    let code = 0;
    if (plat == "windows") {
        code = os.spawn_wait("cmd", "/c", "exit", "7");
    } else {
        code = os.spawn_wait("sh", "-c", "exit 7");
    }
    if (code != 7) {
        io.println("fail spawn_wait");
        io.println(code);
        return 1;
    }

    let pid = 0;
    if (plat == "windows") {
        pid = os.spawn("cmd", "/c", "exit", "3");
    } else {
        pid = os.spawn("sh", "-c", "exit 3");
    }
    if (pid <= 0) {
        io.println("fail spawn pid");
        return 1;
    }
    let waited = os.wait(pid);
    if (waited != 3) {
        io.println("fail wait");
        io.println(waited);
        return 1;
    }

    let td = os.tempdir();
    let at_pid = 0;
    if (plat == "windows") {
        at_pid = os.spawn_at(td, "cmd", "/c", "exit", "0");
    } else {
        at_pid = os.spawn_at(td, "true");
    }
    if (at_pid <= 0) {
        io.println("fail spawn_at");
        return 1;
    }
    let at_code = os.wait(at_pid);
    if (at_code != 0) {
        io.println("fail spawn_at wait");
        io.println(at_code);
        return 1;
    }

    let live = 0;
    if (plat == "windows") {
        live = os.spawn("ping", "-n", "20", "127.0.0.1");
    } else {
        live = os.spawn("sleep", "20");
    }
    if (live <= 0) {
        io.println("fail kill spawn");
        return 1;
    }
    if (os.kill(live) != 1) {
        io.println("fail kill");
        return 1;
    }

    io.println("ok");
}
