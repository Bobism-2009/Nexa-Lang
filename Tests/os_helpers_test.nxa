#include <std/io>
#include <std/os>

fn main() {
    io.println("platform=" + os.platform());
    io.println("hostname=" + os.hostname());
    io.println("username=" + os.username());
    io.println("home=" + os.home());
    os.setenv("NEXA_OS_HELPERS_TEST", "ok");
    io.println("getenv=" + os.getenv("NEXA_OS_HELPERS_TEST"));
}
