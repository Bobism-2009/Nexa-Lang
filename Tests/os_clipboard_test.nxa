#include <std/io>
#include <std/os>

fn main() {
    os.clip_set("Hello from Nexa clipboard!");
    let got = os.clip_get();
    io.println("clipboard now holds: " + got);

    if (got == "Hello from Nexa clipboard!") {
        io.println("roundtrip OK");
    }
    else {
        io.println("roundtrip MISMATCH");
    }
}
