#include <std/io>

fn bump(p: *int) {
    *p = *p + 1;
}

fn main() {
    let x = 10;
    let p: *int = &x;
    io.println(*p);
    *p = 20;
    io.println(x);
    bump(&x);
    io.println(x);

    let q: *int = null;
    if (q == null) {
        io.println("null ok");
    }

    let y = 5;
    let r = &y;
    *r += 2;
    io.println(*r);
}
