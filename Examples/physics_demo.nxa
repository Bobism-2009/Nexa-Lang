// std/physics: a floor, a crate, a post, and a few things happening at once.
//
//   build: NexaC Examples/physics_demo.nxa -o physics_demo
//   drive: arrows orbit, W/S raise and lower, wheel zooms, space stops the
//          camera drifting, click or F drops a ball where the marker sits,
//          C clears those dropped balls, escape quits
//
// gfx3d only draws. Bodies translate and do not spin, so the hill is a
// staircase and the slide is a tilted capsule: a soft ball squashes on each
// hit and keeps going, which is as close to rolling as this solver gets.
// The staircase grips (a box) and the slide is slippery (a capsule).
//
// Softness is per body. The runners, the stack and the cushions are soft.
// The heavy ball is firm, so it dents them and stays round. The balls you
// drop are rigid and bounce. A body you never mark soft stays rigid, and
// the world is not put into squishy mode.
//
// The white marker is a ray from the camera through the point it looks at.
#include <std/gfx3d>
#include <std/physics>
#include <std/io>
#include <std/math>

fn main() {
    if (gfx3d.open("Nexa physics", 900, 620) != 1) {
        io.println("no 3D window: this platform has no backend yet");
        return;
    }
    gfx3d.perspective(55.0, 0.1, 200.0);
    gfx3d.maxfps(60);
    gfx3d.light(-0.4, 0.85, 0.35);
    gfx3d.ambient(64);

    // Floor top is y = 0. The crate and the post are the original static props.
    let floor = physics.box(0.0, -0.5, 0.0, 28.0, 1.0, 28.0);
    physics.mass(floor, 0);
    let crate = physics.box(3.0, 1.0, -1.0, 2.0, 2.0, 2.0);
    physics.mass(crate, 0);
    let post = physics.capsule(-3.2, 0.45, 2.0, -3.2, 2.8, 2.0, 0.45);
    physics.mass(post, 0);

    // Six steps climbing toward +X. Each tread is 0.85 wide and 0.55 taller
    // than the one below it, so a ball with a shove clears the step before
    // the grip stops it. z is 5.2, depth 2.6.
    let s = 0;
    while (s < 6) {
        let h = 0.5 + s * 0.55;
        let x = 5.0 + s * 0.85;
        let step = physics.box(x, h * 0.5, 5.2, 0.9, h, 2.6);
        physics.mass(step, 0);
        s = s + 1;
    }

    // Soft runners. They are put back at the top once they reach the floor.
    let runners: []int;
    s = 0;
    while (s < 3) {
        let z = 4.3 + s * 0.9;
        let id = physics.sphere(9.3, 4.4, z, 0.36);
        physics.soft(id, 0.9);
        physics.velocity(id, -3.4, 0.0, 0.0);
        runners.push(id);
        s = s + 1;
    }

    // A slippery slide on the other side: one capsule, two soft balls.
    let slide = physics.capsule(-10.2, 3.3, -6.4, -4.2, 0.55, -6.4, 0.48);
    physics.mass(slide, 0);
    let sliders: []int;
    s = 0;
    while (s < 2) {
        let z = -6.4 + (s - 0.5) * 0.15;
        let id = physics.sphere(-9.4, 4.3, z, 0.34);
        physics.soft(id, 0.75);
        sliders.push(id);
        s = s + 1;
    }

    // A stack. The bottom carries the rest, so it rests squatter.
    let pile: []int;
    s = 0;
    while (s < 4) {
        let id = physics.sphere(0.2, 0.4 + s * 0.8, -6.0, 0.4);
        physics.soft(id, 0.88);
        pile.push(id);
        s = s + 1;
    }

    // Three cushions and a firm heavy ball dropped onto them.
    let pads: []int;
    s = 0;
    while (s < 3) {
        let id = physics.sphere(-7.4 + s * 0.8, 0.32, -1.6, 0.32);
        physics.soft(id, 0.95);
        pads.push(id);
        s = s + 1;
    }
    let heavy = physics.sphere(-6.6, 3.3, -1.6, 0.6);
    physics.mass(heavy, 5.0);
    physics.soft(heavy, 0.0);
    physics.bounce(heavy, 0.15);

    // A crate with mass, so a landing ball can shove it. It does not tip:
    // nothing here rotates.
    let shove = physics.box(-2.2, 0.6, -3.4, 1.25, 1.2, 1.25);
    physics.mass(shove, 0.8);

    let balls: []int;
    let n = 0;
    while (n < 6) {
        let x = -4.0 + n * 1.5;
        let id = physics.sphere(x, 4.5 + n * 0.35, 0.4, 0.45);
        physics.bounce(id, 0.6);
        balls.push(id);
        n = n + 1;
    }

    let angle = 3.7;
    let height = 9.0;
    let dist = 22.0;
    let spinning = 1;
    let wasDown = 0;
    let lookx = 1.0;
    let looky = 1.6;
    let lookz = 0.6;

    while (gfx3d.closed() != 1) {
        gfx3d.poll();

        if (gfx3d.key("left"))  { angle = angle - 0.02; spinning = 0; }
        if (gfx3d.key("right")) { angle = angle + 0.02; spinning = 0; }
        if (gfx3d.key("w"))     { height = height + 0.1; }
        if (gfx3d.key("s"))     { height = height - 0.1; }
        dist = dist - gfx3d.wheel() * 0.8;
        if (dist < 8.0) { dist = 8.0; }
        if (dist > 48.0) { dist = 48.0; }
        if (gfx3d.pressed("space")) { spinning = 1 - spinning; }
        if (gfx3d.pressed("escape")) { gfx3d.close(); }
        if (spinning == 1) { angle = angle + 0.004; }

        let ex = math.sin(angle) * dist;
        let ey = height;
        let ez = math.cos(angle) * dist;

        physics.step(0.016);

        for (i, len(runners)) {
            let id = runners[i];
            if (physics.x(id) < 4.6 && physics.y(id) < 1.2) {
                let z = 4.3 + i * 0.9;
                physics.set(id, 9.3, 4.4, z);
                physics.velocity(id, -3.4, 0.2, 0.0);
            } else {
                if (physics.vx(id) > -0.7 && physics.x(id) > 5.2) {
                    physics.velocity(id, -3.4, physics.vy(id), 0.0);
                }
            }
        }
        for (i, len(sliders)) {
            let id = sliders[i];
            if (physics.x(id) > -3.6 && physics.y(id) < 1.3) {
                let z = -6.4 + (i - 0.5) * 0.15;
                physics.set(id, -9.4, 4.3, z);
                physics.velocity(id, 0.2, 0.0, 0.0);
            }
        }

        let dx = lookx - ex;
        let dy = looky - ey;
        let dz = lookz - ez;

        let best = -1.0;
        let hx = 0.0;
        let hy = 0.0;
        let hz = 0.0;
        let t = physics.ray_box(ex, ey, ez, dx, dy, dz, 0.0, -0.5, 0.0, 28.0, 1.0, 28.0);
        if (t >= 0.0) { best = t; hx = physics.hx(); hy = physics.hy(); hz = physics.hz(); }
        t = physics.ray_box(ex, ey, ez, dx, dy, dz, 3.0, 1.0, -1.0, 2.0, 2.0, 2.0);
        if (t >= 0.0 && (best < 0.0 || t < best)) {
            best = t; hx = physics.hx(); hy = physics.hy(); hz = physics.hz();
        }
        s = 0;
        while (s < 6) {
            let h = 0.5 + s * 0.55;
            let x = 5.0 + s * 0.85;
            t = physics.ray_box(ex, ey, ez, dx, dy, dz, x, h * 0.5, 5.2, 0.9, h, 2.6);
            if (t >= 0.0 && (best < 0.0 || t < best)) {
                best = t; hx = physics.hx(); hy = physics.hy(); hz = physics.hz();
            }
            s = s + 1;
        }
        t = physics.ray_box(ex, ey, ez, dx, dy, dz,
                            physics.x(shove), physics.y(shove), physics.z(shove),
                            1.25, 1.2, 1.25);
        if (t >= 0.0 && (best < 0.0 || t < best)) {
            best = t; hx = physics.hx(); hy = physics.hy(); hz = physics.hz();
        }
        t = physics.ray_capsule(ex, ey, ez, dx, dy, dz,
                                physics.x1(post), physics.y1(post), physics.z1(post),
                                physics.x2(post), physics.y2(post), physics.z2(post), 0.45);
        if (t >= 0.0 && (best < 0.0 || t < best)) {
            best = t; hx = physics.hx(); hy = physics.hy(); hz = physics.hz();
        }
        t = physics.ray_capsule(ex, ey, ez, dx, dy, dz,
                                physics.x1(slide), physics.y1(slide), physics.z1(slide),
                                physics.x2(slide), physics.y2(slide), physics.z2(slide), 0.48);
        if (t >= 0.0 && (best < 0.0 || t < best)) {
            best = t; hx = physics.hx(); hy = physics.hy(); hz = physics.hz();
        }
        for (i, len(balls)) {
            let id = balls[i];
            t = physics.ray_sphere(ex, ey, ez, dx, dy, dz, physics.x(id), physics.y(id), physics.z(id), 0.45);
            if (t >= 0.0 && (best < 0.0 || t < best)) {
                best = t; hx = physics.hx(); hy = physics.hy(); hz = physics.hz();
            }
        }
        t = physics.ray_sphere(ex, ey, ez, dx, dy, dz, physics.x(heavy), physics.y(heavy), physics.z(heavy), 0.6);
        if (t >= 0.0 && (best < 0.0 || t < best)) {
            best = t; hx = physics.hx(); hy = physics.hy(); hz = physics.hz();
        }

        let down = gfx3d.mouse("left");
        let drop = 0;
        if (down == 1 && wasDown == 0) { drop = 1; }
        wasDown = down;
        if (gfx3d.pressed("f")) { drop = 1; }
        if (drop == 1 && best >= 0.0) {
            if (len(balls) > 40) {
                physics.remove(balls[0]);
                balls.remove(0);
            }
            let id = physics.sphere(hx, hy + 2.5, hz, 0.45);
            physics.bounce(id, 0.6);
            balls.push(id);
        }
        if (gfx3d.pressed("c")) {
            for (id in balls) { physics.remove(id); }
            balls.clear();
        }

        gfx3d.camera(ex, ey, ez, lookx, looky, lookz);
        gfx3d.clear(16, 16, 24);

        gfx3d.box(0.0, -0.5, 0.0, 28.0, 1.0, 28.0, 48, 52, 64);
        gfx3d.box(3.0, 1.0, -1.0, 2.0, 2.0, 2.0, 90, 140, 210);
        gfx3d.capsule(physics.x1(post), physics.y1(post), physics.z1(post),
                      physics.x2(post), physics.y2(post), physics.z2(post),
                      0.45, 90, 190, 120);

        s = 0;
        while (s < 6) {
            let h = 0.5 + s * 0.55;
            let x = 5.0 + s * 0.85;
            let shade = 70 + s * 12;
            gfx3d.box(x, h * 0.5, 5.2, 0.9, h, 2.6, shade, 110, 72);
            s = s + 1;
        }
        gfx3d.capsule(physics.x1(slide), physics.y1(slide), physics.z1(slide),
                      physics.x2(slide), physics.y2(slide), physics.z2(slide),
                      0.48, 70, 120, 150);
        gfx3d.box(physics.x(shove), physics.y(shove), physics.z(shove),
                  1.25, 1.2, 1.25, 180, 120, 70);

        for (i, len(runners)) {
            let id = runners[i];
            gfx3d.ellipsoid(physics.x(id), physics.y(id), physics.z(id),
                            physics.snx(id), physics.sny(id), physics.snz(id),
                            0.36, physics.squash(id), 230, 90, 120);
        }
        for (i, len(sliders)) {
            let id = sliders[i];
            gfx3d.ellipsoid(physics.x(id), physics.y(id), physics.z(id),
                            physics.snx(id), physics.sny(id), physics.snz(id),
                            0.34, physics.squash(id), 80, 190, 210);
        }
        for (i, len(pile)) {
            let id = pile[i];
            gfx3d.ellipsoid(physics.x(id), physics.y(id), physics.z(id),
                            physics.snx(id), physics.sny(id), physics.snz(id),
                            0.4, physics.squash(id), 170, 120, 210);
        }
        for (i, len(pads)) {
            let id = pads[i];
            gfx3d.ellipsoid(physics.x(id), physics.y(id), physics.z(id),
                            physics.snx(id), physics.sny(id), physics.snz(id),
                            0.32, physics.squash(id), 230, 190, 80);
        }
        gfx3d.sphere(physics.x(heavy), physics.y(heavy), physics.z(heavy), 0.6, 60, 64, 78);

        for (i, len(balls)) {
            let id = balls[i];
            let r = 220;
            let g = 90;
            let b = 70;
            if (i % 3 == 1) { r = 80; g = 170; b = 220; }
            if (i % 3 == 2) { r = 230; g = 180; b = 70; }
            gfx3d.sphere(physics.x(id), physics.y(id), physics.z(id), 0.45, r, g, b);
        }
        if (best >= 0.0) { gfx3d.sphere(hx, hy, hz, 0.12, 245, 245, 245); }

        gfx3d.present();
    }

    gfx3d.close();
}
