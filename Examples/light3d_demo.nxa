// std/gfx3d lighting: one sphere, one light, standing still.
//
//   build: NexaC Examples/light3d_demo.nxa -o light3d_demo && ./light3d_demo
//   drive: escape quits. Nothing else moves -- that is the point of it
//
// The smallest thing that shows what gfx3d.light is for. A sphere in one flat
// colour is a circle; the same sphere with a light on it is round. That is the
// whole feature, and it is easier to see standing still than sweeping about.
//
// The light comes from the left and above, and far enough round towards the
// front to still read as facing us: about two thirds of the visible face is
// lit and the remaining third falls away into shadow down the right side.
//
// How far round it sits is the one number here worth choosing carefully. Put
// the light square behind the camera and the whole visible face is lit and the
// sphere is a flat disc again; swing it out to the side and half goes dark.
// The lit fraction is (1 + cos t) / 2, for t the angle between the light and
// the way the camera is looking -- so t near 70 degrees, as here, is where a
// shadow is a real part of the picture rather than a rim around the edge.
//
// Ambient is turned well down from its default of 87, and that is what makes
// it dark: ambient is how lit a surface facing AWAY from the light still is,
// so lowering it deepens the shadow without touching the lit side at all. The
// bright edge reads 215 either way; only the dark side moves, down to 25 here.
//
// Two things this does not have, deliberately. There is no marker showing
// where the light is, because gfx3d.light takes a DIRECTION and not a place --
// a sun, with nowhere it actually is and no falloff with distance. And there
// is no second shape, because one sphere already faces every direction at
// once: whatever angle the light arrives from, some of the surface is
// square-on to it and some is edge-on, so the entire range of the shading is
// on screen in a single object.
#include <std/gfx3d>
#include <std/io>

fn main() {
    if (gfx3d.open("Nexa 3D lighting", 900, 620) != 1) {
        io.println("no 3D window: this platform has no backend yet");
        return;
    }
    gfx3d.perspective(55.0, 0.1, 100.0);
    gfx3d.maxfps(60);

    // Set once, outside the loop. The light is state the module keeps, not
    // something a frame is drawn with: gfx3d.clear puts the model transform
    // back but deliberately leaves the light alone, so a scene lit the same
    // way every frame says so once. (Place it inside the loop when it moves --
    // there is nothing to create or destroy, it is a direction and a level.)
    gfx3d.light(-0.80, 0.48, 0.35);
    gfx3d.ambient(30);
    io.println("ambient: " + gfx3d.ambient() + " (default is 87)");

    // Set once as well: nothing in the scene moves, so nothing about the view
    // has to be worked out again every frame. Slightly above the middle, which
    // puts the lit side up and across rather than flat on.
    gfx3d.camera(0.0, 1.2, 8.5,  0.0, 0.0, 0.0);

    while (gfx3d.closed() != 1) {
        gfx3d.poll();
        if (gfx3d.pressed("escape")) { gfx3d.close(); }

        gfx3d.clear(10, 10, 14);

        // Near-white on purpose: a strong colour of its own would compete with
        // the shading for the same pixels. Curved shapes hand over the
        // direction the surface really points at each corner, which is what
        // makes this shade smoothly instead of in facets.
        gfx3d.sphere(0.0, 0.0, 0.0, 2.6, 215, 215, 220);

        gfx3d.present();
    }

    gfx3d.close();
}
