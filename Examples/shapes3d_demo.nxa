// Every std/gfx3d shape, on one screen.
//
//   build: NexaC Examples/shapes3d_demo.nxa -o shapes3d_demo && ./shapes3d_demo
//   drive: arrows orbit, W/S raise and lower, wheel zooms, space stops the
//          camera drifting, 1/2/3 move the light, B beeps, M holds a note,
//          escape quits
//
// The cyan cube and the small pale sphere are turned by gfx3d.translate and
// gfx3d.rotate rather than by moving the camera, and show the two orders:
// move-then-turn tumbles in place, turn-then-move swings around the origin.
//
// B and M are std/gfx's mixer, reached through gfx3d: the same sound calls
// with the same names, because it is the same mixer. Nothing here opens an
// audio stream or tops it up -- gfx3d.play does the first and the gfx3d.poll()
// this loop was already calling does the second.
//
// Also the quickest way to see whether a change to the geometry broke
// anything: a sphere wound inside-out shows a gash through its equator, a
// capsule loses an end cap, a cone's base scoops inward. None of that is
// visible to the test suite, which cannot render a frame and look at it.
#include <std/gfx3d>
#include <std/io>
#include <std/math>

fn main() {
    if (gfx3d.open("Nexa 3D shapes", 900, 620) != 1) {
        io.println("no 3D window: this platform has no backend yet");
        return;
    }
    gfx3d.perspective(55.0, 0.1, 200.0);
    gfx3d.maxfps(60);

    let angle = 0.55;
    let spin = 0.0;
    let height = 6.0;
    let dist = 16.0;
    let spinning = 1;
    let lightMode = 0;

    // Any PCM WAV works; this is the 0.05 s sine the test suite ships. The
    // fallback is for running the demo from the Tests directory.
    let beep: int = gfx3d.sound("Tests/gfx_beep.wav");
    if (beep == 0) { beep = gfx3d.sound("gfx_beep.wav"); }
    let held: int = 0;

    while (gfx3d.closed() != 1) {
        gfx3d.poll();

        if (gfx3d.key("left"))  { angle = angle - 0.02; spinning = 0; }
        if (gfx3d.key("right")) { angle = angle + 0.02; spinning = 0; }
        if (gfx3d.key("w"))     { height = height + 0.1; }
        if (gfx3d.key("s"))     { height = height - 0.1; }
        dist = dist - gfx3d.wheel() * 0.8;
        if (dist < 5.0) { dist = 5.0; }
        if (dist > 60.0) { dist = 60.0; }
        if (gfx3d.pressed("space")) { spinning = 1 - spinning; }
        if (gfx3d.pressed("escape")) { gfx3d.close(); }
        // Fire and forget: press it repeatedly and the voices pile up, up to
        // sixteen of them, rather than cutting each other off.
        if (gfx3d.pressed("b")) { gfx3d.play(beep); }
        if (gfx3d.pressed("m")) {
            if (held == 0) { held = gfx3d.loop(beep, 150); }
            else { gfx3d.stop(held); held = 0; }
        }
        if (spinning == 1) { angle = angle + 0.004; }
        spin = spin + 0.8;

        gfx3d.camera(math.sin(angle) * dist, height, math.cos(angle) * dist,
                     0.0, 1.0, 0.0);
        // The light is placed each frame, so 1/2/3 can move it while the
        // scene runs. It is in world space: the tumbling cube below turns
        // into and out of it rather than carrying its own lighting along.
        if (gfx3d.pressed("1")) { lightMode = 0; }
        if (gfx3d.pressed("2")) { lightMode = 1; }
        if (gfx3d.pressed("3")) { lightMode = 2; }
        if (lightMode == 0) { gfx3d.light(-0.4, 0.82, 0.41); gfx3d.ambient(87); }
        if (lightMode == 1) { gfx3d.light(1.0, 0.25, 0.3); gfx3d.ambient(18); }
        if (lightMode == 2) { gfx3d.light(-0.3, 0.9, 0.3, 255, 150, 70); gfx3d.ambient(50); }

        gfx3d.clear(16, 16, 24);

        // The ground, so everything else has somewhere to stand.
        gfx3d.grid(28.0, 1.5, 52, 52, 70);

        // Curved shapes shade smoothly: each corner hands over the direction
        // the surface really points there.
        gfx3d.sphere(-7.0, 1.6, 0.0, 1.6, 220, 90, 70);
        gfx3d.capsule(-3.2, 0.9, 0.0, -3.2, 3.0, 0.0, 0.9, 90, 200, 120);
        gfx3d.cylinder(0.6, 0.0, 0.0, 0.6, 3.2, 0.0, 1.0, 90, 140, 230);
        gfx3d.cone(4.6, 0.0, 0.0, 4.6, 3.8, 0.0, 1.3, 240, 190, 80);

        // Flat-sided ones take the direction of the face, so their edges stay
        // sharp instead of being smoothed away.
        gfx3d.box(8.6, 1.0, 0.0, 2.2, 2.0, 1.2, 200, 120, 210);

        // The transform: this cube is written at the origin and put where it
        // belongs, tumbling where it stands. The camera is doing none of it.
        gfx3d.translate(12.0, 1.2, 0.0);
        gfx3d.rotate(spin, spin * 0.7, 0.0);
        gfx3d.cube(0.0, 0.0, 0.0, 1.8, 120, 210, 210);
        gfx3d.reset();

        // Turn first and move second, and the shape swings around the origin
        // instead of turning in place -- the same two calls, the other way up.
        // The offset has to be across the axis being turned about, or the
        // shape just spins where it is: translating along Y after a Y
        // rotation moves it along the very line it is turning around.
        gfx3d.rotate(0.0, spin * 1.6, 0.0);
        gfx3d.translate(5.5, 4.6, 0.0);
        gfx3d.sphere(0.0, 0.0, 0.0, 0.45, 240, 240, 200);
        gfx3d.reset();

        // A capsule lying down is the shape a character controller uses: every
        // point within its radius of the line between its two ends.
        gfx3d.capsule(-7.0, 0.5, -5.5, 1.0, 0.5, -5.5, 0.5, 230, 160, 90);

        // A lone triangle is drawn from both sides, so it never disappears.
        gfx3d.tri(-2.0, 0.1, 5.0,  2.0, 0.1, 5.0,  0.0, 3.0, 5.0,  240, 210, 90);

        // Lines are not shaded -- there is no surface to catch anything.
        gfx3d.line3(-9.0, 5.2, -5.5, 13.0, 5.2, -5.5, 255, 255, 255);

        gfx3d.present();
    }

    gfx3d.close();
}
