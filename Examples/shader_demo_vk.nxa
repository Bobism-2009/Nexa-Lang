// The wave shader again, on the Vulkan renderer.
//
//   build: NexaC Examples/shader_demo_vk.nxa -o shader_demo_vk && ./shader_demo_vk
//   quit:  escape, or close the window
//
// Same effect as shader_demo.nxa, which is the OpenGL one. The difference is
// where the compiling happens. OpenGL hands the GLSL to the graphics driver at
// run time; Vulkan has no runtime GLSL compiler, so NexaC compiles
// Examples/shaders/wave_vk.vert and .frag to .spv as part of the build. It
// needs glslangValidator or glslc for that and offers to install one the first
// time a build wants it -- say no and this still builds, it just finds no .spv
// to load and says so.
//
// Two files rather than one because the dialects differ: the Vulkan pair
// declares its inputs with layout(location = ...) and reads uMVP out of a
// push-constant block. The effect, and gfx3d.shader_set, are the same.
#include <std/io>
#include <std/gfx3d>
#include <std/time>

fn main() {
    gfx3d.renderer("vulkan 1.4");
    gfx3d.open("Nexa custom shader - Vulkan", 640, 480);

    let sh: int = gfx3d.shader("Examples/shaders/wave_vk.vert",
                               "Examples/shaders/wave_vk.frag");
    if (sh == 0) {
        io.println("custom shader unavailable: ", gfx3d.shader_error());
        io.println("falling back to the built-in shader");
    } else {
        io.println("custom shader ready; backend is ", gfx3d.backend());
        gfx3d.use_shader(sh);
    }

    let start: float = time.now_ms();
    while (!gfx3d.closed()) {
        gfx3d.poll();
        if (gfx3d.pressed("escape")) {
            gfx3d.close();
        }
        gfx3d.clear(14, 14, 22);
        gfx3d.camera(3.5, 2.5, 3.5, 0.0, 0.0, 0.0);

        // The first name this program sets is the first of the sixteen floats
        // the renderer pushes, which is the uUser[0].x the shader reads.
        let t: float = (time.now_ms() - start) / 1000.0;
        if (sh != 0) {
            gfx3d.shader_set(sh, "uTime", t);
        }

        gfx3d.grid(6.0, 0.5, 40, 40, 60);
        gfx3d.cube(0.0, 0.5, 0.0, 1.0, 200, 90, 70);
        gfx3d.cube(1.6, 0.5, 0.0, 0.6, 90, 180, 120);
        gfx3d.cube(-1.6, 0.5, 0.0, 0.6, 110, 130, 220);

        gfx3d.present();
    }
    return;
}
