// A tour of std/term: colour, a loading bar, and an arrow-key menu read with
// raw getkey. Run it in a real terminal: NexaC term_demo.nxa --run
#include <std/io>
#include <std/term>
#include <std/time>

// One line of the frame: write the text over whatever was there, then clear to
// the end of the line (not before writing), so nothing blanks and nothing flashes.
fn line(text: string) {
    io.print(text);
    term.clear_eol();
    io.println("");
}

fn main() {
    term.hide_cursor();
    defer term.show_cursor();

    // 1. A loading bar that fills in place -- term.progress draws and redraws it.
    io.println(term.bold(term.color("std/term demo", "cyan")));
    io.println(term.dim("loading..."));
    for (i, 41) {
        term.progress(i, 40);
        io.flush();
        time.sleep(time.milliseconds(20));
    }
    io.println("");

    // 2. An arrow-key menu, redrawn from the top each frame by overwriting lines
    //    in place (cursor home, write-then-clear-to-end) -- no screen clear, no flicker.
    let items = ["New game", "Load game", "Settings", "Quit"];
    let pick = 0;
    let message: string = "";
    term.raw(true);
    defer term.raw(false);

    while (true) {
        term.home();
        line(term.bold(term.color("std/term demo", "cyan")));
        line(term.dim("up / down to move, enter to pick, q to quit"));
        line("");
        for (i, len(items)) {
            if (i == pick) {
                line("  " + term.color(">", "yellow") + " " + term.reverse(" " + items[i] + " "));
            } else {
                line("    " + term.dim(items[i]));
            }
        }
        line("");
        line(message);
        io.flush();

        let k = term.getkey();
        if (k == "up") { if (pick > 0) { pick = pick - 1; } }
        if (k == "down") { if (pick < len(items) - 1) { pick = pick + 1; } }
        if (k == "q") { break; }
        if (k == "enter") {
            if (pick == len(items) - 1) { break; }
            message = term.color("you chose: " + items[pick], "green");
        }
    }

    term.clear();
    io.println(term.color("bye", "bright_green"));
}
