// A tour of std/term: colour, a cursor-driven progress bar, and an arrow-key
// menu read with raw getkey. Run it in a real terminal: NexaC term_demo.nxa --run
#include <std/io>
#include <std/term>
#include <std/time>

fn bar(n: int, w: int): string {
    let s: string = "";
    for (i, w) {
        if (i < n) { s = s + "#"; } else { s = s + "-"; }
    }
    return s;
}

// One menu line: clear just this line, then write it. Called from the top of
// the screen downward, this overwrites the old frame in place -- no full-screen
// clear, so nothing flashes.
fn line(text: string) {
    term.clear_line();
    io.println(text);
}

fn main() {
    term.hide_cursor();
    defer term.show_cursor();

    // 1. A bar that fills in place.
    io.println(term.bold(term.color("std/term demo", "cyan")));
    io.println(term.dim("loading..."));
    for (i, 21) {
        term.clear_line();
        io.print("  ", term.color(bar(i, 20), "green"), " ", i * 5, "%");
        io.flush();
        time.sleep(time.milliseconds(40));
    }

    // 2. An arrow-key menu, redrawn from the top each frame (cursor home, then
    //    overwrite line by line) so it updates without flicker.
    let items = ["New game", "Load game", "Settings", "Quit"];
    let pick = 0;
    let message: string = "";
    term.raw(true);
    defer term.raw(false);

    while (true) {
        term.home();
        line(term.bold(term.color("std/term demo", "cyan")));
        line(term.dim("up / down to move, enter to pick, q to quit"));
        line("");
        for (i, len(items)) {
            if (i == pick) {
                line("  " + term.color(">", "yellow") + " " + term.reverse(" " + items[i] + " "));
            } else {
                line("    " + term.dim(items[i]));
            }
        }
        line("");
        line(message);          // always drawn (empty when none), so no stale text
        io.flush();

        let k = term.getkey();
        if (k == "up") { if (pick > 0) { pick = pick - 1; } }
        if (k == "down") { if (pick < len(items) - 1) { pick = pick + 1; } }
        if (k == "q") { break; }
        if (k == "enter") {
            if (pick == len(items) - 1) { break; }
            message = term.color("you chose: " + items[pick], "green");
        }
    }

    term.clear();
    io.println(term.color("bye", "bright_green"));
}
